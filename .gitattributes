# 저장소 안에서는 LF 로 정규화한다. 작업 복사본의 줄 끝은 OS 기본을 따른다.
* text=auto

# 바이너리 — 변환하지 않는다
*.bin      binary
*.gguf     binary
*.png      binary
*.jpg      binary

# 생성물이면서 바이트 비교 테스트의 대상이다 (GenNpcs_IsReproducible).
# 생성기가 LF 로 쓰므로 작업 복사본도 LF 로 고정한다 — CRLF 로 체크아웃되면 길이부터 어긋난다.
masterdata/npc_instances.json  text eol=lf

# PowerShell 스크립트는 Windows PowerShell 5.1 이 읽는다.
# UTF-8 BOM 이 없으면 한국어 주석을 깨뜨리므로 working-tree 를 CRLF 로 고정한다.
*.ps1      text eol=crlf
