<Project>

  <!--
    docs/11_Phase1_W2-4_Core_Runtime.md §2 의 설정을 그대로 따른다.
    솔루션 전체 공통. 개별 csproj 에서 재정의하지 않는다.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    CLAUDE.md §2.3 결정론 · §2.1 틱 루프 규칙을 컴파일 단계에서 거들기 위한 분석기 설정.
    경고 억제(#pragma warning disable)를 금지하므로 기본 분석기는 켜 둔다.
  -->
  <PropertyGroup>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <!--
    릴리스 버전 (A-09). MAJOR.MINOR.PATCH 하나로 관리한다.

    CI 가 태그에서 덮어쓴다: dotnet build -p:VersionPrefix=1.2.3 -p:SourceRevisionId=(짧은 커밋 해시).
    빌드 메타(계약 버전·프리픽스 해시)는 실행 시 /status.version 이 합쳐 낸다 —
    프리픽스 해시는 마스터데이터에서 나오는 값이라 컴파일 시점에 알 수 없다.
  -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Product>LLM NPC Server</Product>
    <Company>LLM NPC Server</Company>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
