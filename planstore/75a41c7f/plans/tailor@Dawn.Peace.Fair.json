{
  "schema": 1,
  "bucket": "tailor@Dawn.Peace.Fair",
  "archetype": "tailor",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "restock_and_craft_linen",
  "reasoning": "Dawn, peaceful, and the tailor has tools and coin. The goal is to restock cloth and fulfill orders. First, go to the workplace, withdraw linen, craft shirts, store them, and then rest.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$workplace",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Withdraw",
      "args": {
        "item": "linen",
        "count": 6
      },
      "timeout_s": 300
    },
    {
      "action": "Craft",
      "args": {
        "recipe": "linen_shirt",
        "count": 2
      },
      "timeout_s": 1800
    },
    {
      "action": "Store",
      "args": {
        "item": "linen_shirt",
        "count": 2
      },
      "timeout_s": 120
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home"
      },
      "timeout_s": 600
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}