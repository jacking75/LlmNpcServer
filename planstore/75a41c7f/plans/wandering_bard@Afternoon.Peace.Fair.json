{
  "schema": 1,
  "bucket": "wandering_bard@Afternoon.Peace.Fair",
  "archetype": "wandering_bard",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "perform_and_wander",
  "reasoning": "afternoon, peaceful; perform at the market, then wander and socialize, and finally head home to rest",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$market",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Perform",
      "args": {
        "kind": "song",
        "duration_s": 1800
      },
      "timeout_s": 2400
    },
    {
      "action": "Gossip",
      "args": {
        "npc": "nearest:villager",
        "topic": "rumor"
      },
      "timeout_s": 600
    },
    {
      "action": "Wander",
      "args": {
        "duration_s": 1200
      },
      "timeout_s": 1800
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}