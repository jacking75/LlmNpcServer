{
  "schema": 1,
  "bucket": "herbalist@Night.Peace.Fair",
  "archetype": "herbalist",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "night_rest_and_prepare",
  "reasoning": "Nighttime, peaceful, and herbalist has product and coin. Prepare for morning gathering by resting and organizing inventory.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Store",
      "args": {
        "item": "herb",
        "count": 10
      },
      "timeout_s": 300
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Rest",
      "args": {
        "duration_s": 1800
      },
      "timeout_s": 2400
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}