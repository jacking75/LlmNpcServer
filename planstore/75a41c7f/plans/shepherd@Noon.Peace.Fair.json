{
  "schema": 1,
  "bucket": "shepherd@Noon.Peace.Fair",
  "archetype": "shepherd",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "graze_flock_and_shear",
  "reasoning": "Daytime, peaceful, fair weather. Shepherd needs to graze flock, shear wool, and milk herd. Focus on grazing and shearing for now, milking can wait for evening.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$nearest_field",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Gather",
      "args": {
        "resource": "wool",
        "count": 5
      },
      "timeout_s": 1200
    },
    {
      "action": "Wander",
      "args": {
        "duration_s": 1800
      },
      "timeout_s": 1800
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Store",
      "args": {
        "item": "wool",
        "count": 5
      },
      "timeout_s": 120
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Evening"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}