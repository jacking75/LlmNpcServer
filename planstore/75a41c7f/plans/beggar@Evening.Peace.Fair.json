{
  "schema": 1,
  "bucket": "beggar@Evening.Peace.Fair",
  "archetype": "beggar",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "seek_shelter_and_rest",
  "reasoning": "Evening, peaceful; the previous plan failed trying to go to a field. Beggars don't have fields. Instead, move to nearest shelter and rest, then sleep.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$nearest_shelter",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Rest",
      "args": {
        "duration_s": 1800
      },
      "timeout_s": 1200
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}