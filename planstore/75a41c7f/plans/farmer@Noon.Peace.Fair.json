{
  "schema": 1,
  "bucket": "farmer@Noon.Peace.Fair",
  "archetype": "farmer",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "daily_harvest_and_store",
  "reasoning": "Daytime, peaceful, fair weather, high diligence. Focus on farming, storing the produce, and resting before the evening.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$nearest_field",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Farm",
      "args": {
        "crop": "wheat",
        "count": 10
      },
      "timeout_s": 1200
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Store",
      "args": {
        "item": "wheat",
        "count": 10
      },
      "timeout_s": 120
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Rest",
      "args": {
        "duration_s": 600
      },
      "timeout_s": 1200
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}