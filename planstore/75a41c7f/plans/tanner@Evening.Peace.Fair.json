{
  "schema": 1,
  "bucket": "tanner@Evening.Peace.Fair",
  "archetype": "tanner",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "tan_leather_and_rest",
  "reasoning": "Evening, peaceful, and the tanner needs to process hides. They will work to tan leather, store it, and then rest for the night.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$workplace"
      },
      "timeout_s": 600
    },
    {
      "action": "Withdraw",
      "args": {
        "item": "hide",
        "count": 6
      },
      "timeout_s": 300
    },
    {
      "action": "Craft",
      "args": {
        "recipe": "leather",
        "count": 3
      },
      "timeout_s": 1800
    },
    {
      "action": "Store",
      "args": {
        "item": "leather",
        "count": 3
      },
      "timeout_s": 120
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home"
      },
      "timeout_s": 600
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}