{
  "schema": 1,
  "bucket": "jeweler@Morning.Peace.Fair",
  "archetype": "jeweler",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "restock_gems_and_craft",
  "reasoning": "Morning, peaceful; need raw materials for crafting, so withdraw ore and then craft rings.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$workplace"
      },
      "timeout_s": 600
    },
    {
      "action": "Withdraw",
      "args": {
        "item": "silver_ore",
        "count": 4
      },
      "timeout_s": 300
    },
    {
      "action": "Craft",
      "args": {
        "recipe": "silver_ring",
        "count": 2
      },
      "timeout_s": 1800
    },
    {
      "action": "Store",
      "args": {
        "item": "silver_ring",
        "count": 2
      },
      "timeout_s": 120
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home"
      },
      "timeout_s": 600
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}