{
  "schema": 1,
  "bucket": "shepherd@Noon.Peace.Cold",
  "archetype": "shepherd",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "graze_flock_and_return_home",
  "reasoning": "Noon, peaceful, cold weather. Shepherd needs to graze flock, then return home to rest and sleep. No immediate threats or special tasks.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$nearest_field",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Gather",
      "args": {
        "resource": "wool",
        "count": 5
      },
      "timeout_s": 1200
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Drink",
      "args": {},
      "timeout_s": 120
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Store",
      "args": {
        "item": "wool",
        "count": 5
      },
      "timeout_s": 120
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}