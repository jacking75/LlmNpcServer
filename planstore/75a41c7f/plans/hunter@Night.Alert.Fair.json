{
  "schema": 1,
  "bucket": "hunter@Night.Alert.Fair",
  "archetype": "hunter",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "night_hunt_and_scout",
  "reasoning": "Night, alert but peaceful region. Hunter needs to scout and hunt. Move to woods, gather resources, then return home.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$nearest_field",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Gather",
      "args": {
        "resource": "game_meat",
        "count": 3
      },
      "timeout_s": 900
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$patrol_route",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Observe",
      "args": {
        "target": "nearest:villager",
        "duration_s": 600
      },
      "timeout_s": 900
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}