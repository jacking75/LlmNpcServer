{
  "schema": 1,
  "bucket": "brewer@Noon.Peace.Fair",
  "archetype": "brewer",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "brew_and_supply",
  "reasoning": "Daytime, peaceful, and has raw materials. Brew ale, sell it at the market, then rest.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$workplace"
      },
      "timeout_s": 600
    },
    {
      "action": "Work",
      "args": {
        "recipe": "ale",
        "count": 4
      },
      "timeout_s": 1800
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$market"
      },
      "timeout_s": 600
    },
    {
      "action": "Trade",
      "args": {
        "item": "ale",
        "amount": 16
      },
      "timeout_s": 600
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home"
      },
      "timeout_s": 600
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}