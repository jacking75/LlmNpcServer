{
  "schema": 1,
  "bucket": "priest@Noon.Peace.Fair",
  "archetype": "priest",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "daily_shrine_duties",
  "reasoning": "Daytime, peaceful, and priest archetype. Focus on shrine duties, then social interaction, and finally rest.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$temple",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Pray",
      "args": {
        "duration_s": 1800
      },
      "timeout_s": 2400
    },
    {
      "action": "Gossip",
      "args": {
        "npc": "nearest:villager",
        "topic": "rumor"
      },
      "timeout_s": 600
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}