{
  "schema": 1,
  "bucket": "miner@Evening.Alert.Cold",
  "archetype": "miner",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "mine_and_sell_ore",
  "reasoning": "Evening, alert but peaceful. Mine ore, then sell it at the market before heading home to rest. Avoids excessive back-and-forth.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$nearest_field",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Mine",
      "args": {
        "resource": "iron_ore",
        "count": 5
      },
      "timeout_s": 1800
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$market",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Trade",
      "args": {
        "item": "iron_ore",
        "amount": 5
      },
      "timeout_s": 600
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}