{
  "schema": 1,
  "bucket": "shepherd@Evening.Peace.Fair",
  "archetype": "shepherd",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "graze_flock_and_return_home",
  "reasoning": "Evening, peaceful, fair weather. Shepherd needs to graze flock, then head home for the night. Gather some resources before returning.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$nearest_field",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Gather",
      "args": {
        "resource": "wool",
        "count": 5
      },
      "timeout_s": 900
    },
    {
      "action": "Gather",
      "args": {
        "resource": "milk",
        "count": 5
      },
      "timeout_s": 900
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Store",
      "args": {
        "item": "wool",
        "count": 5
      },
      "timeout_s": 120
    },
    {
      "action": "Store",
      "args": {
        "item": "milk",
        "count": 5
      },
      "timeout_s": 120
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}