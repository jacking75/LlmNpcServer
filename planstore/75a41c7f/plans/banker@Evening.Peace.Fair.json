{
  "schema": 1,
  "bucket": "banker@Evening.Peace.Fair",
  "archetype": "banker",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "secure_funds_and_rest",
  "reasoning": "Evening, peaceful; banker should secure funds, then go home to rest.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$workplace"
      },
      "timeout_s": 600
    },
    {
      "action": "Store",
      "args": {
        "item": "coin",
        "count": 50
      },
      "timeout_s": 300
    },
    {
      "action": "Talk",
      "args": {
        "npc": "nearest:villager",
        "topic": "trade"
      },
      "timeout_s": 120
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home"
      },
      "timeout_s": 600
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}