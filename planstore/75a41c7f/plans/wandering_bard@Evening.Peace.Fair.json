{
  "schema": 1,
  "bucket": "wandering_bard@Evening.Peace.Fair",
  "archetype": "wandering_bard",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "perform_and_travel",
  "reasoning": "evening, peaceful, high sociability; perform at the tavern, then wander towards home for the night",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$tavern",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Perform",
      "args": {
        "kind": "song",
        "duration_s": 1800
      },
      "timeout_s": 3600
    },
    {
      "action": "Gossip",
      "args": {
        "npc": "nearest:villager",
        "topic": "rumor"
      },
      "timeout_s": 300
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}