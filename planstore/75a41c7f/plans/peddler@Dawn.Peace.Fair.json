{
  "schema": 1,
  "bucket": "peddler@Dawn.Peace.Fair",
  "archetype": "peddler",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "sell_wares_and_gather_news",
  "reasoning": "Dawn, peaceful. A peddler should start by going to the market to sell wares, then gather news before returning home to rest.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$market",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Trade",
      "args": {
        "item": "bread",
        "amount": 5
      },
      "timeout_s": 600
    },
    {
      "action": "Gossip",
      "args": {
        "npc": "nearest:villager",
        "topic": "rumor"
      },
      "timeout_s": 300
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Store",
      "args": {
        "item": "coin",
        "count": 20
      },
      "timeout_s": 120
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}