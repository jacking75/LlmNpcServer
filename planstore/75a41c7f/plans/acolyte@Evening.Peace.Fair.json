{
  "schema": 1,
  "bucket": "acolyte@Evening.Peace.Fair",
  "archetype": "acolyte",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "evening_prayer_and_rest",
  "reasoning": "Evening, peaceful. The acolyte should pray at the temple, then go home to rest. The previous plan failed because it tried to repair without a tool.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$temple",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Pray",
      "args": {
        "duration_s": 900
      },
      "timeout_s": 1200
    },
    {
      "action": "Gossip",
      "args": {
        "npc": "nearest:villager",
        "topic": "rumor"
      },
      "timeout_s": 600
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}