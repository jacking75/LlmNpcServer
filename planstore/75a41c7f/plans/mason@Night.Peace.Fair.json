{
  "schema": 1,
  "bucket": "mason@Night.Peace.Fair",
  "archetype": "mason",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "quarry_and_cut_stone_at_night",
  "reasoning": "Nighttime, peaceful, and the mason has tools and food. They should go to the quarry, gather stone, cut it into blocks, and then return home to sleep.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$nearest_field",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Gather",
      "args": {
        "resource": "stone",
        "count": 10
      },
      "timeout_s": 1800
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$workplace"
      },
      "timeout_s": 600
    },
    {
      "action": "Craft",
      "args": {
        "recipe": "stone_block",
        "count": 3
      },
      "timeout_s": 1800
    },
    {
      "action": "Store",
      "args": {
        "item": "stone_block",
        "count": 3
      },
      "timeout_s": 120
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home"
      },
      "timeout_s": 600
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}