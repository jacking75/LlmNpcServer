{
  "schema": 1,
  "bucket": "stablemaster@Night.Peace.Fair",
  "archetype": "stablemaster",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "stable_chores_and_rest",
  "reasoning": "Nighttime, peaceful, fair weather. Stablemaster needs to do basic upkeep, then rest. No urgent tasks, so a simple loop of tending to the stable, then preparing for bed.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$workplace"
      },
      "timeout_s": 600
    },
    {
      "action": "Repair",
      "args": {
        "target": "$workplace"
      },
      "timeout_s": 900
    },
    {
      "action": "Observe",
      "args": {
        "target": "self",
        "duration_s": 600
      },
      "timeout_s": 900
    },
    {
      "action": "Talk",
      "args": {
        "npc": "nearest:villager",
        "topic": "greeting"
      },
      "timeout_s": 120
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home"
      },
      "timeout_s": 600
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}