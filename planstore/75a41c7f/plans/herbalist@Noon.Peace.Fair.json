{
  "schema": 1,
  "bucket": "herbalist@Noon.Peace.Fair",
  "archetype": "herbalist",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "gather_and_dry_herbs",
  "reasoning": "Daytime, peaceful, and fair weather. The herbalist should gather herbs, process them, and store them before heading home.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$nearest_field",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Gather",
      "args": {
        "resource": "herb",
        "count": 10
      },
      "timeout_s": 1800
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$workplace"
      },
      "timeout_s": 600
    },
    {
      "action": "Store",
      "args": {
        "item": "herb",
        "count": 10
      },
      "timeout_s": 120
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home"
      },
      "timeout_s": 600
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}