{
  "schema": 1,
  "bucket": "woodcutter@Afternoon.Alert.Fair",
  "archetype": "woodcutter",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "gather_timber_and_return",
  "reasoning": "afternoon, alert but peaceful; gather timber, then return home to rest and prepare for the night.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$nearest_field",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Gather",
      "args": {
        "resource": "timber",
        "count": 5
      },
      "timeout_s": 1200
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Store",
      "args": {
        "item": "timber",
        "count": 5
      },
      "timeout_s": 120
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Rest",
      "args": {
        "duration_s": 600
      },
      "timeout_s": 1200
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}