{
  "schema": 1,
  "bucket": "scribe@Dawn.Peace.Fair",
  "archetype": "scribe",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "copy_texts_and_draw_maps",
  "reasoning": "Dawn, peaceful, scribe archetype. Start the day by preparing materials at the workplace, then work on copying texts and drawing maps. Store the finished products and end the day at home.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$workplace",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Withdraw",
      "args": {
        "item": "parchment",
        "count": 5
      },
      "timeout_s": 300
    },
    {
      "action": "Work",
      "args": {
        "recipe": "parchment",
        "count": 5
      },
      "timeout_s": 1800
    },
    {
      "action": "Work",
      "args": {
        "recipe": "map",
        "count": 2
      },
      "timeout_s": 1800
    },
    {
      "action": "Store",
      "args": {
        "item": "map",
        "count": 2
      },
      "timeout_s": 120
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}