{
  "schema": 1,
  "bucket": "alchemist@Afternoon.Peace.Fair",
  "archetype": "alchemist",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "restock_and_brew",
  "reasoning": "Afternoon, peaceful, and the alchemist needs herbs. Gather herbs, then brew potions at the workplace, and finally rest at home.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$nearest_field",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Gather",
      "args": {
        "resource": "herb",
        "count": 6
      },
      "timeout_s": 1800
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$workplace"
      },
      "timeout_s": 600
    },
    {
      "action": "Craft",
      "args": {
        "recipe": "healing_potion",
        "count": 2
      },
      "timeout_s": 1800
    },
    {
      "action": "Store",
      "args": {
        "item": "healing_potion",
        "count": 2
      },
      "timeout_s": 120
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home"
      },
      "timeout_s": 600
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}