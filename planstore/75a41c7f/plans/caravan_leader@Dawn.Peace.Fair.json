{
  "schema": 1,
  "bucket": "caravan_leader@Dawn.Peace.Fair",
  "archetype": "caravan_leader",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "prepare_and_depart_caravan",
  "reasoning": "Dawn, peaceful, on duty; prepare the caravan by loading goods, then head out to escort and trade.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$workplace"
      },
      "timeout_s": 600
    },
    {
      "action": "Withdraw",
      "args": {
        "item": "iron_ore",
        "count": 10
      },
      "timeout_s": 300
    },
    {
      "action": "Store",
      "args": {
        "item": "iron_ore",
        "count": 10
      },
      "timeout_s": 120
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$market"
      },
      "timeout_s": 600
    },
    {
      "action": "Trade",
      "args": {
        "item": "iron_ore",
        "amount": 10
      },
      "timeout_s": 600
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$gate"
      },
      "timeout_s": 600
    },
    {
      "action": "Guard",
      "args": {
        "poi": "$gate",
        "duration_s": 1800
      },
      "timeout_s": 2400
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home"
      },
      "timeout_s": 600
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}