      "action": "MoveTo",
      "args": {
        "poi": "$market",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Wait",
      "args": {
        "duration_s": 300
      },
      "timeout_s": 600
    },
    {
      "action": "Trade",
      "args": {
        "item": "bread",
        "amount": 10
      },
      "timeout_s": 600
    },
    {
      "action": "Gossip",
      "args": {
        "npc": "nearest:villager",
        "topic": "trade"
      },
      "timeout_s": 300
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
