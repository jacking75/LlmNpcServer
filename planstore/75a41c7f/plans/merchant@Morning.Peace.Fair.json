{
  "schema": 1,
  "bucket": "merchant@Morning.Peace.Fair",
  "archetype": "merchant",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "open_stall_and_trade",
