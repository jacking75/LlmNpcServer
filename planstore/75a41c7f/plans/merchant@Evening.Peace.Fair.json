{
  "schema": 1,
  "bucket": "merchant@Evening.Peace.Fair",
  "archetype": "merchant",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "evening_trade_and_rest",
  "reasoning": "Evening, peaceful, and high sociability/greed. The merchant should go to the market, trade goods, and then head home to rest.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$market",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Trade",
      "args": {
        "item": "bread",
        "amount": 10
      },
      "timeout_s": 600
    },
    {
      "action": "Gossip",
      "args": {
        "npc": "nearest:villager",
        "topic": "trade"
      },
      "timeout_s": 300
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Store",
      "args": {
        "item": "coin",
        "count": 20
      },
      "timeout_s": 120
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}