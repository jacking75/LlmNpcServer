{
  "schema": 1,
  "bucket": "scholar@Dawn.Peace.Fair",
  "archetype": "scholar",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "morning_study_and_rest",
  "reasoning": "Dawn, peaceful, scholar archetype. Start the day with study at the temple, then return home to rest and prepare for the day.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$temple",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Pray",
      "args": {
        "duration_s": 900
      },
      "timeout_s": 1200
    },
    {
      "action": "Observe",
      "args": {
        "target": "nearest:acolyte",
        "duration_s": 600
      },
      "timeout_s": 900
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Rest",
      "args": {
        "duration_s": 600
      },
      "timeout_s": 1200
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}