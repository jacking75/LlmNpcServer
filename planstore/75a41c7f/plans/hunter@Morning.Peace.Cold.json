{
  "schema": 1,
  "bucket": "hunter@Morning.Peace.Cold",
  "archetype": "hunter",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "hunt_and_scout",
  "reasoning": "Morning, peaceful, on duty; hunt for game, scout the woods, and return home to rest.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$nearest_field",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Gather",
      "args": {
        "resource": "game_meat",
        "count": 5
      },
      "timeout_s": 1800
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$patrol_route",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Observe",
      "args": {
        "target": "nearest:villager",
        "duration_s": 600
      },
      "timeout_s": 900
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Store",
      "args": {
        "item": "game_meat",
        "count": 5
      },
      "timeout_s": 120
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}