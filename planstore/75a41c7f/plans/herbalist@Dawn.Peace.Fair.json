{
  "schema": 1,
  "bucket": "herbalist@Dawn.Peace.Fair",
  "archetype": "herbalist",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "collect_and_process_herbs",
  "reasoning": "Dawn, peaceful, and has tools. Collect herbs at the field, process them at home, and then rest.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$nearest_field",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Gather",
      "args": {
        "resource": "herb",
        "count": 10
      },
      "timeout_s": 1800
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Store",
      "args": {
        "item": "herb",
        "count": 10
      },
      "timeout_s": 120
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Rest",
      "args": {
        "duration_s": 600
      },
      "timeout_s": 1200
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}