{
  "schema": 1,
  "bucket": "miner@Morning.Alert.Cold",
  "archetype": "miner",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "mine_ore_and_rest",
  "reasoning": "Morning, alert but peaceful; need to mine ore, so go to the field, mine a decent amount, then head home to rest.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$nearest_field",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Mine",
      "args": {
        "resource": "iron_ore",
        "count": 8
      },
      "timeout_s": 1800
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Store",
      "args": {
        "item": "iron_ore",
        "count": 8
      },
      "timeout_s": 120
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Rest",
      "args": {
        "duration_s": 900
      },
      "timeout_s": 1200
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}