{
  "schema": 1,
  "bucket": "merchant@Afternoon.Peace.Fair",
  "archetype": "merchant",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "manage_market_stall",
  "reasoning": "Afternoon, peaceful, and merchant archetype. Focus on trading and restocking at the market, then head home to rest.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$market",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Trade",
      "args": {
        "item": "bread",
        "amount": 10
      },
      "timeout_s": 600
    },
    {
      "action": "Observe",
      "args": {
        "target": "nearest:villager",
        "duration_s": 600
      },
      "timeout_s": 900
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Store",
      "args": {
        "item": "coin",
        "count": 20
      },
      "timeout_s": 120
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}