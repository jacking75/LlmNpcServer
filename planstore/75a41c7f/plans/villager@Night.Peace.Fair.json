{
  "schema": 1,
  "bucket": "villager@Night.Peace.Fair",
  "archetype": "villager",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "evening_routine_and_rest",
  "reasoning": "Night, peaceful, and fair weather. Villager has food, water, coin. Plan to move home, eat, and sleep.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Drink",
      "args": {},
      "timeout_s": 120
    },
    {
      "action": "Gossip",
      "args": {
        "npc": "nearest:villager",
        "topic": "rumor"
      },
      "timeout_s": 300
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}