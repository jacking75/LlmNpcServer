{
  "schema": 1,
  "bucket": "merchant@Noon.Peace.Fair",
  "archetype": "merchant",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "daily_trade_and_restock",
  "reasoning": "Daytime, peaceful, and merchant archetype with high sociability and greed. Focus on trading at the market, then restocking and resting.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$market",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Trade",
      "args": {
        "item": "bread",
        "amount": 10
      },
      "timeout_s": 600
    },
    {
      "action": "Perform",
      "args": {
        "kind": "song",
        "duration_s": 900
      },
      "timeout_s": 1200
    },
    {
      "action": "Gossip",
      "args": {
        "npc": "nearest:villager",
        "topic": "trade"
      },
      "timeout_s": 300
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Store",
      "args": {
        "item": "coin",
        "count": 20
      },
      "timeout_s": 120
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}