{
  "schema": 1,
  "bucket": "shepherd@Afternoon.Peace.Cold",
  "archetype": "shepherd",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "graze_flock_then_rest",
  "reasoning": "afternoon, peaceful, cold; shepherd needs to graze the flock, then rest before nightfall. Previous attempt failed due to invalid target for Observe.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$nearest_field",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Observe",
      "args": {
        "target": "nearest:shepherd",
        "duration_s": 600
      },
      "timeout_s": 900
    },
    {
      "action": "Gather",
      "args": {
        "resource": "wool",
        "count": 2
      },
      "timeout_s": 900
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Rest",
      "args": {
        "duration_s": 1800
      },
      "timeout_s": 2400
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}