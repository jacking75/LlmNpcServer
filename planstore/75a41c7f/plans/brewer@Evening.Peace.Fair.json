{
  "schema": 1,
  "bucket": "brewer@Evening.Peace.Fair",
  "archetype": "brewer",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "ferment_and_sell_ale",
  "reasoning": "Evening, peaceful; brew ale, sell it at the market, then head home to rest.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$workplace"
      },
      "timeout_s": 600
    },
    {
      "action": "Withdraw",
      "args": {
        "item": "wheat",
        "count": 15
      },
      "timeout_s": 300
    },
    {
      "action": "Craft",
      "args": {
        "recipe": "ale",
        "count": 3
      },
      "timeout_s": 1800
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$market"
      },
      "timeout_s": 600
    },
    {
      "action": "Trade",
      "args": {
        "item": "ale",
        "amount": 12
      },
      "timeout_s": 600
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home"
      },
      "timeout_s": 600
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}