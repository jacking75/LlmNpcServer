{
  "schema": 1,
  "bucket": "brewer@Morning.Peace.Fair",
  "archetype": "brewer",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "brew_and_supply",
  "reasoning": "Morning, peaceful, and has product. Start by brewing more ale, then sell it at the tavern, and finally rest at home.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$workplace"
      },
      "timeout_s": 600
    },
    {
      "action": "Withdraw",
      "args": {
        "item": "wheat",
        "count": 9
      },
      "timeout_s": 300
    },
    {
      "action": "Craft",
      "args": {
        "recipe": "ale",
        "count": 3
      },
      "timeout_s": 1800
    },
    {
      "action": "Store",
      "args": {
        "item": "ale",
        "count": 12
      },
      "timeout_s": 120
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$tavern"
      },
      "timeout_s": 600
    },
    {
      "action": "Trade",
      "args": {
        "item": "ale",
        "amount": 10
      },
      "timeout_s": 600
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home"
      },
      "timeout_s": 600
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}