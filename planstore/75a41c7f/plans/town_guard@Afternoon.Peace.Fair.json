{
  "schema": 1,
  "bucket": "town_guard@Afternoon.Peace.Fair",
  "archetype": "town_guard",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "patrol_market_then_home",
  "reasoning": "Afternoon, peaceful, on duty. Patrol the market to observe citizens, then return home to rest before night.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$market",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Observe",
      "args": {
        "target": "nearest:villager",
        "duration_s": 900
      },
      "timeout_s": 1200
    },
    {
      "action": "Greet",
      "args": {
        "npc": "nearest:villager"
      },
      "timeout_s": 60
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Rest",
      "args": {
        "duration_s": 1800
      },
      "timeout_s": 2400
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}