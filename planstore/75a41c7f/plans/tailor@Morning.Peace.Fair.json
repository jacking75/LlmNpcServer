{
  "schema": 1,
  "bucket": "tailor@Morning.Peace.Fair",
  "archetype": "tailor",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "restock_and_craft",
  "reasoning": "The tailor needs raw materials (linen) to craft shirts. The previous plan failed because it didn't acquire any. This plan adds a step to withdraw linen from storage before crafting.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$workplace"
      },
      "timeout_s": 600
    },
    {
      "action": "Withdraw",
      "args": {
        "item": "linen",
        "count": 6
      },
      "timeout_s": 300
    },
    {
      "action": "Craft",
      "args": {
        "recipe": "linen_shirt",
        "count": 2
      },
      "timeout_s": 1800
    },
    {
      "action": "Store",
      "args": {
        "item": "linen_shirt",
        "count": 2
      },
      "timeout_s": 120
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home"
      },
      "timeout_s": 600
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}