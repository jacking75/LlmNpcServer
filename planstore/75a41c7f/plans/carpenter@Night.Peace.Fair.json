{
  "schema": 1,
  "bucket": "carpenter@Night.Peace.Fair",
  "archetype": "carpenter",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "restock_and_craft_planks",
  "reasoning": "night, peaceful, and has tools. Gather timber at the nearest field, craft planks, store them, then rest at home.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$nearest_field",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Gather",
      "args": {
        "resource": "timber",
        "count": 4
      },
      "timeout_s": 900
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$workplace"
      },
      "timeout_s": 600
    },
    {
      "action": "Craft",
      "args": {
        "recipe": "plank",
        "count": 2
      },
      "timeout_s": 1800
    },
    {
      "action": "Store",
      "args": {
        "item": "plank",
        "count": 6
      },
      "timeout_s": 120
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home"
      },
      "timeout_s": 600
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}