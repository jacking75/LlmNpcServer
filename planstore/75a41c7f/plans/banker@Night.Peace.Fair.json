{
  "schema": 1,
  "bucket": "banker@Night.Peace.Fair",
  "archetype": "banker",
  "version": 1,
  "origin": "Runtime",
  "plan": {
  "schema": 1,
  "goal": "secure_vault_and_rest",
  "reasoning": "Night time, peaceful region. Banker's primary role is to secure the vault. After securing, they should rest.",
  "steps": [
    {
      "action": "MoveTo",
      "args": {
        "poi": "$workplace",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Observe",
      "args": {
        "target": "poi_owner:$workplace",
        "duration_s": 1800
      },
      "timeout_s": 2400
    },
    {
      "action": "Store",
      "args": {
        "item": "coin",
        "count": 50
      },
      "timeout_s": 300
    },
    {
      "action": "MoveTo",
      "args": {
        "poi": "$home",
        "speed": "walk"
      },
      "timeout_s": 600
    },
    {
      "action": "Eat",
      "args": {},
      "timeout_s": 300
    },
    {
      "action": "Sleep",
      "args": {
        "until_time": "Morning"
      },
      "timeout_s": 7200
    }
  ],
  "on_step_fail": "fallback",
  "loop": true
}
}