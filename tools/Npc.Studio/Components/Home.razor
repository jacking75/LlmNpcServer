@page "/"
@inject StudioWorkspace Workspace

<PageTitle>NPC Studio</PageTitle>

<header class="topbar">
    <div class="brand">
        <span class="brand-mark">N</span>
        <div><strong>NPC Studio</strong><small>마스터데이터 오써링 도구</small></div>
    </div>
    <div class="top-actions">
        <span class="path">@(_catalog?.Directory ?? "불러오는 중")</span>
        @if (_catalog?.ReadOnly == true) { <span class="badge warn">읽기 전용</span> }
        <button class="secondary" @onclick="ValidateAsync" disabled="@_busy">전체 검증</button>
        <button class="secondary" @onclick="RefreshAsync" disabled="@_busy">새로고침</button>
        <a class="manual" href="/docs/npc_studio_manual.html" target="_blank">매뉴얼</a>
    </div>
</header>

<div class="workspace">
    <aside class="sidebar">
        <nav class="mode-tabs">
            <button class="@ModeClass("archetype")" @onclick='() => SwitchMode("archetype")'>아키타입</button>
            <button class="@ModeClass("npc")" @onclick='() => SwitchMode("npc")'>개별 NPC</button>
            <button class="@ModeClass("file")" @onclick='() => SwitchMode("file")'>JSON 파일</button>
        </nav>

        @if (_mode == "archetype")
        {
            <div class="side-tools">
                <input placeholder="직업 검색" @bind="_search" @bind:event="oninput" />
                <button class="primary full" @onclick="OpenCreate">+ 새 직업 만들기</button>
            </div>
            <div class="entity-list">
                @foreach (StudioArchetype item in FilteredArchetypes)
                {
                    <button class="entity @SelectedClass(item.Id)" @onclick="() => SelectArchetypeAsync(item.Id)">
                        <span class="entity-icon">@item.Id[..1].ToUpperInvariant()</span>
                        <span><strong>@item.Id</strong><small>code @item.Code · @(item.Population)명 · @item.Workplace</small></span>
                    </button>
                }
            </div>
        }
        else if (_mode == "npc")
        {
            <div class="side-tools">
                <label>NPC 검색</label>
                <input placeholder="ID · 직업 · 지역 · 장소" @bind="_npcSearch" @bind:event="oninput" />
                <label class="check-line"><input type="checkbox" @bind="_onlyOverrides" /> 오버라이드가 있는 NPC만</label>
                <p class="help">아키타입 → 지역 순으로 묶는다. 생성 명단은 읽기 전용이고 개별 차이만 오버라이드로 정의한다.</p>
                <button class="secondary full" @onclick='() => SelectFileAsync("npc_overrides.json")'>오버라이드 편집</button>
            </div>
            <div class="entity-list npc-groups">
                @if (!_npcDirectoryLoaded)
                {
                    <p class="help group-loading">NPC 명단을 읽는 중이다…</p>
                }
                else if (!GroupedNpcs.Any())
                {
                    <p class="help group-loading">조건에 맞는 NPC가 없다.</p>
                }
                else
                {
                    @foreach (IGrouping<string, StudioNpcSummary> archetype in GroupedNpcs)
                    {
                        string archetypeKey = "a:" + archetype.Key;
                        bool archetypeOpen = HasNpcSearch || _openNpcGroups.Contains(archetypeKey);
                        <button class="npc-group" @onclick="() => ToggleNpcGroup(archetypeKey)">
                            <span>@(archetypeOpen ? "▾" : "▸")</span><strong>@archetype.Key</strong><span class="group-count">@archetype.Count()</span>
                        </button>
                        @if (archetypeOpen)
                        {
                            @foreach (IGrouping<string, StudioNpcSummary> zone in archetype.GroupBy(n => n.Zone).OrderBy(g => g.Key, StringComparer.Ordinal))
                            {
                                string zoneKey = archetypeKey + "/" + zone.Key;
                                bool zoneOpen = HasNpcSearch || _openNpcGroups.Contains(zoneKey);
                                <button class="npc-zone" @onclick="() => ToggleNpcGroup(zoneKey)">
                                    <span>@(zoneOpen ? "▾" : "▸")</span><strong>@zone.Key</strong><span>@zone.Count()명 · 변경 @zone.Count(n => n.HasOverride)</span>
                                </button>
                                @if (zoneOpen)
                                {
                                    @foreach (StudioNpcSummary npc in zone.Take(100))
                                    {
                                        <button class="npc-row @SelectedClass(npc.Id.ToString())" @onclick="() => SelectNpcAsync(npc.Id)">
                                            <span class="npc-id">#@npc.Id</span>
                                            <span><strong>@npc.Home</strong><small>@npc.Workplace@if (npc.HasOverride) { <em>변경됨</em> }</small></span>
                                        </button>
                                    }
                                    @if (zone.Count() > 100)
                                    {
                                        <p class="list-limit">앞 100명만 표시한다. 검색하면 나머지도 찾을 수 있다.</p>
                                    }
                                }
                            }
                        }
                    }
                }
            </div>
        }
        else
        {
            <div class="entity-list files">
                @foreach (string file in EditableFiles)
                {
                    <button class="entity @SelectedClass(file)" @onclick="() => SelectFileAsync(file)">
                        <span class="file-dot"></span><span><strong>@file</strong><small>@FileDescription(file)</small></span>
                    </button>
                }
            </div>
        }
    </aside>

    <main class="main">
        @if (_busy)
        {
            <div class="loading">마스터데이터를 읽는 중이다…</div>
        }
        else if (_createOpen)
        {
            <section class="panel create-panel">
                <div class="panel-head"><div><small>NEW ARCHETYPE</small><h1>새 직업 만들기</h1></div><button class="icon-btn" @onclick="CloseCreate">×</button></div>
                <p class="lead">기존 직업을 복제하고 그 인구 일부를 새 직업으로 나눈다. 폴백 플랜과 버킷 수도 함께 갱신하므로 중간에 깨진 상태를 만들지 않는다.</p>
                <div class="form-grid">
                    <label><span>새 ID</span><input placeholder="beekeeper" @bind="_newId" /></label>
                    <label><span>복제 원본</span><select @bind="_fromId">@foreach (StudioArchetype a in _catalog!.Archetypes) { <option value="@a.Id">@a.Id (@a.Weight.ToString("0.####"))</option> }</select></label>
                    <label><span>인구 가중치</span><input type="number" min="0.0001" max="0.9999" step="0.0001" @bind="_newWeight" /></label>
                </div>
                <div class="callout">저장 후 설명은 <code>TODO:</code>로 생성된다. 반드시 아키타입 JSON에서 세계관에 맞는 문장으로 바꿔야 한다.</div>
                <div class="button-row"><button class="primary" @onclick="CreateAsync">검증하고 생성</button><button class="secondary" @onclick="CloseCreate">취소</button></div>
            </section>
        }
        else if (_mode == "archetype" && _document is not null)
        {
            <section class="hero-card">
                <div><small>ARCHETYPE · @_selected</small><h1>@_selected</h1><p>@SelectedSummary?.Description</p></div>
                <div class="stat-grid"><div><strong>@SelectedSummary?.Population</strong><span>예상 인구</span></div><div><strong>@SelectedSummary?.Weight.ToString("0.####")</strong><span>가중치</span></div><div><strong>@SelectedSummary?.Workplace</strong><span>일터</span></div></div>
            </section>
            <nav class="content-tabs"><button class="@TabClass("json")" @onclick='() => _tab = "json"'>JSON 편집</button><button class="@TabClass("card")" @onclick='() => _tab = "card"'>설명 카드</button></nav>
            @if (_tab == "json")
            {
                <section class="panel editor-panel">
                    <div class="panel-head"><div><small>archetypes.json</small><h2>@_selected 항목</h2></div><button class="primary" @onclick="SaveArchetypeAsync" disabled="@(_catalog?.ReadOnly == true)">검증하고 저장</button></div>
                    <div class="draft-grid">
                        <div><div class="pane-label">JSON 초안</div><textarea class="code-editor" spellcheck="false" value="@_editor" @oninput="OnArchetypeInput"></textarea></div>
                        <div class="live-preview">
                            <div class="preview-head"><span>실시간 설명</span>@if (string.IsNullOrEmpty(_previewError)) { <span class="live-dot">● 반영됨</span> } else { <span class="preview-bad">JSON 확인 필요</span> }</div>
                            @if (!string.IsNullOrEmpty(_previewError))
                            {
                                <div class="preview-error"><strong>현재 초안을 설명할 수 없다.</strong><span>@_previewError</span><small>아래에는 마지막으로 정상 해석한 설명을 유지한다.</small></div>
                            }
                            <MarkdownView Content="@_previewCard" Class="preview-card" />
                        </div>
                    </div>
                </section>
            }
            else
            {
                <section class="panel"><div class="panel-head"><div><small>현재 JSON 초안 기준</small><h2>아키타입 카드</h2></div></div>@if (!string.IsNullOrEmpty(_previewError)) { <div class="preview-error"><strong>JSON 확인 필요</strong><span>@_previewError</span></div> }<MarkdownView Content="@_previewCard" /></section>
            }
        }
        else if (_mode == "npc" && !string.IsNullOrEmpty(_npcCard))
        {
            <section class="panel npc-card-panel">
                <div class="panel-head"><div><small>INSTANCE · NPC @_npcId</small><h1>개별 NPC 카드</h1>@if (SelectedNpcSummary is { } selectedNpc) { <p>@selectedNpc.Archetype · @selectedNpc.Zone · @selectedNpc.Home → @selectedNpc.Workplace @if (selectedNpc.HasOverride) { <span class="badge warn">오버라이드 적용</span> }</p> }</div></div>
                <MarkdownView Content="@_npcCard" />
            </section>
            @if (_npcEditor is not null)
            {
                <section class="panel override-panel">
                    <div class="panel-head">
                        <div><small>npc_overrides.json</small><h2>NPC @_npcId 개별 설정</h2><p>생성된 집·일터·스폰은 유지하고 이 NPC만 다른 행동 파라미터를 정의한다.</p></div>
                        <div class="button-row compact"><button class="primary" @onclick="SaveNpcOverrideAsync" disabled="@(_catalog?.ReadOnly == true)">검증하고 저장</button><button class="secondary danger" @onclick="DeleteNpcOverrideAsync" disabled="@(_catalog?.ReadOnly == true || !_npcEditor.Exists)">오버라이드 삭제</button></div>
                    </div>
                    <div class="override-grid">
                        <div class="wide patrol-field">
                            <span class="field-title">순찰 경로 POI</span>
                            <div class="patrol-picker">
                                <div class="selected-route">
                                    <strong>선택한 순서</strong>
                                    @if (SelectedPatrolRoute.IsEmpty)
                                    {
                                        <p>아직 선택한 장소가 없다. 아래 목록에서 순찰할 장소를 추가한다.</p>
                                    }
                                    else
                                    {
                                        @for (int index = 0; index < SelectedPatrolRoute.Length; index++)
                                        {
                                            int routeIndex = index;
                                            string poiId = SelectedPatrolRoute[index];
                                            StudioPoiChoice? choice = FindPoiChoice(poiId);
                                            <div class="route-row">
                                                <span class="route-number">@(index + 1)</span>
                                                <span><strong>@poiId</strong><small>@PoiDescription(choice)</small></span>
                                                <span class="route-actions"><button title="앞으로" @onclick="() => MovePatrolPoi(routeIndex, -1)" disabled="@(index == 0)">↑</button><button title="뒤로" @onclick="() => MovePatrolPoi(routeIndex, 1)" disabled="@(index == SelectedPatrolRoute.Length - 1)">↓</button><button title="제거" @onclick="() => RemovePatrolPoi(routeIndex)">×</button></span>
                                            </div>
                                        }
                                    }
                                </div>
                                <div class="poi-browser">
                                    <div class="poi-search"><strong>같은 지역의 장소</strong><input placeholder="장소 ID · 유형 · 세부 종류 검색" @bind="_poiSearch" @bind:event="oninput" /></div>
                                    <div class="poi-choice-list">
                                        @foreach (StudioPoiChoice poi in FilteredPoiChoices)
                                        {
                                            bool selected = SelectedPatrolRoute.Contains(poi.Id, StringComparer.Ordinal);
                                            <button class="poi-choice" @onclick="() => AddPatrolPoi(poi.Id)" disabled="@(selected || SelectedPatrolRoute.Length >= 4)">
                                                <span><strong>@poi.Id</strong><small>@PoiDescription(poi)</small></span><em>@(selected ? "선택됨" : "+ 추가")</em>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                            <small class="field-help">같은 지역의 장소를 최대 4개까지 순서대로 선택한다.</small>
                            <details class="direct-poi-input"><summary>POI ID를 직접 입력한다</summary><textarea rows="3" placeholder="guardhouse_001_04, market_stall_001_04" @bind="_npcPatrolText"></textarea><small>쉼표나 줄바꿈으로 구분한다. 목록에 없는 ID는 저장 검증에서 거절된다.</small></details>
                        </div>
                        <label><span>경계 반경(m)</span><input type="number" min="0" max="200" placeholder="아키타입 기본값" @bind="_npcAggroRadius" /></label>
                        <label><span>세력</span><select @bind="_npcFaction"><option value="">미지정</option>@foreach (string faction in _npcEditor.Factions) { <option value="@faction">@faction</option> }</select></label>
                        <label><span>대화 프로필</span><input placeholder="guard_stern_01" @bind="_npcDialogueProfile" /></label>
                        <label><span>일정 오프셋(분)</span><input type="number" min="-120" max="120" placeholder="추가 오프셋 없음" @bind="_npcScheduleOffset" /></label>
                    </div>
                </section>
            }
        }
        else if (_mode == "file" && !string.IsNullOrEmpty(_selected))
        {
            <section class="panel editor-panel">
                <div class="panel-head"><div><small>MASTERDATA</small><h1>@_selected</h1><p>@FileDescription(_selected)</p></div><button class="primary" @onclick="SaveFileAsync" disabled="@(_catalog?.ReadOnly == true)">검증하고 저장</button></div>
                <textarea class="code-editor file-editor" spellcheck="false" @bind="_editor"></textarea>
            </section>
        }
        else
        {
            <section class="empty-state"><div class="empty-icon">◇</div><h1>NPC 정의를 선택한다</h1><p>왼쪽에서 직업, 개별 NPC 또는 JSON 파일을 선택한다.</p></section>
        }
    </main>

    <aside class="inspector">
        <div class="inspector-head"><span>검증 결과</span><span class="count @IssueClass">@_issues.Length</span></div>
        @if (_issues.IsEmpty)
        {
            <div class="all-good"><span>✓</span><strong>전체 검증 통과</strong><p>현재 마스터데이터에서 V1~V13 위반이 없다.</p></div>
        }
        else
        {
            <div class="issue-list">@foreach (StudioIssue issue in _issues) { <article class="issue"><strong>@issue.Code · @issue.File</strong><code>@issue.Path</code><p>@issue.Detail</p>@if (!string.IsNullOrEmpty(issue.FixHint)) { <small>@issue.FixHint</small> }</article> }</div>
        }
        <div class="guardrails"><h3>편집 안전장치</h3><ul><li>생성물은 편집 목록에서 제외한다.</li><li>저장 전 전체 검증을 수행한다.</li><li>로더가 거절하면 원본을 유지한다.</li><li>ID와 code 재배치를 허용하지 않는다.</li></ul></div>
    </aside>
</div>

@if (!string.IsNullOrEmpty(_toast))
{
    <div class="toast @(_toastError ? "error" : "success")">@_toast</div>
}

@code {
    private static readonly string[] EditableFiles = ["npc_overrides.json", "archetypes.json", "fallback_plans.json", "interrupts.json", "pois.json", "zones.json", "items.json", "actions.json", "factions.json", "dialogue_lines.json", "context_buckets.json", "world_flags.json"];
    private StudioCatalog? _catalog;
    private StudioArchetypeDocument? _document;
    private ImmutableArray<StudioNpcSummary> _npcDirectory = [];
    private ImmutableArray<StudioIssue> _issues = [];
    private readonly HashSet<string> _openNpcGroups = new(StringComparer.Ordinal);
    private string _mode = "archetype";
    private string _tab = "json";
    private string _selected = string.Empty;
    private string _editor = string.Empty;
    private string _previewCard = string.Empty;
    private string _previewError = string.Empty;
    private string _search = string.Empty;
    private string _npcSearch = string.Empty;
    private int _npcId = 1;
    private string _npcCard = string.Empty;
    private StudioNpcOverrideEditor? _npcEditor;
    private string _npcPatrolText = string.Empty;
    private string _poiSearch = string.Empty;
    private int? _npcAggroRadius;
    private string _npcFaction = string.Empty;
    private string _npcDialogueProfile = string.Empty;
    private int? _npcScheduleOffset;
    private int _previewVersion;
    private bool _busy = true;
    private bool _createOpen;
    private bool _npcDirectoryLoaded;
    private bool _onlyOverrides;
    private string _newId = string.Empty;
    private string _fromId = "blacksmith";
    private double _newWeight = 0.001;
    private string _toast = string.Empty;
    private bool _toastError;

    protected override void OnInitialized() => Refresh();

    private IEnumerable<StudioArchetype> FilteredArchetypes => _catalog?.Archetypes.Where(a => string.IsNullOrWhiteSpace(_search) || a.Id.Contains(_search, StringComparison.OrdinalIgnoreCase)) ?? [];
    private IEnumerable<StudioNpcSummary> FilteredNpcs => _npcDirectory.Where(n => (!_onlyOverrides || n.HasOverride) && MatchesNpcSearch(n));
    private IEnumerable<IGrouping<string, StudioNpcSummary>> GroupedNpcs => FilteredNpcs.GroupBy(n => n.Archetype).OrderBy(g => g.Key, StringComparer.Ordinal);
    private IEnumerable<StudioPoiChoice> FilteredPoiChoices => _npcEditor?.ZonePois.Where(MatchesPoiSearch) ?? [];
    private ImmutableArray<string> SelectedPatrolRoute => ParsePatrolRoute();
    private StudioArchetype? SelectedSummary => _catalog?.Archetypes.FirstOrDefault(a => a.Id == _selected);
    private StudioNpcSummary? SelectedNpcSummary => _npcDirectory.FirstOrDefault(n => n.Id == _npcId);
    private bool HasNpcSearch => !string.IsNullOrWhiteSpace(_npcSearch);
    private string IssueClass => _issues.IsEmpty ? "ok" : "bad";

    private void Refresh()
    {
        try { _catalog = Workspace.LoadCatalog(); _issues = _catalog.Issues; _npcDirectoryLoaded = false; if (_mode == "npc") LoadNpcDirectory(); else if (_catalog.Archetypes.Length > 0 && string.IsNullOrEmpty(_selected)) SelectArchetype(_catalog.Archetypes[0].Id); }
        catch (Exception ex) { Toast(ex.Message, true); }
        finally { _busy = false; }
    }

    private Task RefreshAsync() { _busy = true; Refresh(); return Task.CompletedTask; }
    private Task ValidateAsync() { try { _issues = Workspace.Validate(); Toast(_issues.IsEmpty ? "전체 검증을 통과했다." : $"검증 문제 {_issues.Length}건이 있다.", !_issues.IsEmpty); } catch (Exception ex) { Toast(ex.Message, true); } return Task.CompletedTask; }
    private void SwitchMode(string mode) { _mode = mode; _selected = string.Empty; _document = null; _npcCard = string.Empty; _npcEditor = null; _createOpen = false; if (mode == "npc") LoadNpcDirectory(); }
    private Task SelectArchetypeAsync(string id) { SelectArchetype(id); return Task.CompletedTask; }
    private void SelectArchetype(string id) { try { _mode = "archetype"; _selected = id; _document = Workspace.LoadArchetype(id); _editor = _document.Json; _previewCard = _document.Card; _previewError = string.Empty; _tab = "json"; _createOpen = false; } catch (Exception ex) { Toast(ex.Message, true); } }
    private Task SelectFileAsync(string file) { try { _mode = "file"; _selected = file; _editor = Workspace.LoadFile(file); _document = null; _npcEditor = null; _createOpen = false; } catch (Exception ex) { Toast(ex.Message, true); } return Task.CompletedTask; }
    private Task SelectNpcAsync(int id)
    {
        try
        {
            _npcId = id;
            _npcCard = Workspace.LoadNpcCard(id);
            _selected = id.ToString();
            LoadNpcEditorFields(Workspace.LoadNpcOverride(id));
        }
        catch (Exception ex) { Toast(ex.Message, true); }
        return Task.CompletedTask;
    }
    private void OpenCreate() { _createOpen = true; _newId = string.Empty; _fromId = _catalog?.Archetypes.FirstOrDefault()?.Id ?? "blacksmith"; }
    private void CloseCreate() => _createOpen = false;

    private Task CreateAsync()
    {
        try { StudioSaveResult result = Workspace.CreateArchetype(_newId.Trim(), _fromId, _newWeight); ApplyResult(result); if (result.Saved) { _catalog = Workspace.LoadCatalog(); _issues = _catalog.Issues; SelectArchetype(_newId.Trim()); } }
        catch (Exception ex) { Toast(ex.Message, true); }
        return Task.CompletedTask;
    }

    private Task SaveArchetypeAsync()
    {
        try { StudioSaveResult result = Workspace.SaveArchetype(_selected, _editor); ApplyResult(result); if (result.Saved) { _catalog = Workspace.LoadCatalog(); SelectArchetype(_selected); } }
        catch (Exception ex) { Toast(ex.Message, true); }
        return Task.CompletedTask;
    }

    private Task SaveFileAsync()
    {
        try { StudioSaveResult result = Workspace.SaveFile(_selected, _editor); ApplyResult(result); if (result.Saved) { _catalog = Workspace.LoadCatalog(); _issues = _catalog.Issues; _editor = Workspace.LoadFile(_selected); } }
        catch (Exception ex) { Toast(ex.Message, true); }
        return Task.CompletedTask;
    }

    private Task SaveNpcOverrideAsync()
    {
        try
        {
            var draft = new StudioNpcOverrideDraft(
                _npcId,
                SelectedPatrolRoute,
                _npcAggroRadius,
                _npcFaction,
                _npcDialogueProfile,
                _npcScheduleOffset);
            StudioSaveResult result = Workspace.SaveNpcOverride(draft);
            ApplyResult(result);
            if (result.Saved) ReloadNpcAfterOverride();
        }
        catch (Exception ex) { Toast(ex.Message, true); }
        return Task.CompletedTask;
    }

    private Task DeleteNpcOverrideAsync()
    {
        _npcPatrolText = string.Empty;
        _npcAggroRadius = null;
        _npcFaction = string.Empty;
        _npcDialogueProfile = string.Empty;
        _npcScheduleOffset = null;
        return SaveNpcOverrideAsync();
    }

    private void ApplyResult(StudioSaveResult result) { _issues = result.Issues; Toast(result.Message, !result.Saved); }
    private void Toast(string message, bool error) { _toast = message; _toastError = error; }
    private void LoadNpcDirectory()
    {
        if (_npcDirectoryLoaded) return;
        try
        {
            _npcDirectory = Workspace.LoadNpcDirectory();
            _npcDirectoryLoaded = true;
            StudioNpcSummary? first = _npcDirectory.FirstOrDefault();
            if (first is not null)
            {
                _openNpcGroups.Add("a:" + first.Archetype);
                _openNpcGroups.Add("a:" + first.Archetype + "/" + first.Zone);
            }
        }
        catch (Exception ex) { Toast(ex.Message, true); }
    }

    private void LoadNpcEditorFields(StudioNpcOverrideEditor editor)
    {
        _npcEditor = editor;
        _npcPatrolText = string.Join(", ", editor.PatrolRoute);
        _poiSearch = string.Empty;
        _npcAggroRadius = editor.AggroRadiusM;
        _npcFaction = editor.Faction;
        _npcDialogueProfile = editor.DialogueProfile;
        _npcScheduleOffset = editor.ScheduleOffsetMinutes;
    }

    private void ReloadNpcAfterOverride()
    {
        _npcDirectory = Workspace.LoadNpcDirectory();
        _npcDirectoryLoaded = true;
        _npcCard = Workspace.LoadNpcCard(_npcId);
        LoadNpcEditorFields(Workspace.LoadNpcOverride(_npcId));
    }

    private ImmutableArray<string> ParsePatrolRoute() =>
    [
        .. _npcPatrolText
            .Split([',', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.Ordinal),
    ];

    private bool MatchesPoiSearch(StudioPoiChoice poi)
    {
        if (string.IsNullOrWhiteSpace(_poiSearch)) return true;
        string query = _poiSearch.Trim();
        return poi.Id.Contains(query, StringComparison.OrdinalIgnoreCase)
            || poi.Type.Contains(query, StringComparison.OrdinalIgnoreCase)
            || poi.Subtype.Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private StudioPoiChoice? FindPoiChoice(string id) =>
        _npcEditor?.ZonePois.FirstOrDefault(p => p.Id == id);

    private static string PoiDescription(StudioPoiChoice? poi)
    {
        if (poi is null) return "현재 지역 목록에서 찾을 수 없는 ID다.";
        string relation = poi.IsHome ? " · 이 NPC의 집" : poi.IsWorkplace ? " · 이 NPC의 일터" : string.Empty;
        return $"{poi.Type} / {poi.Subtype} · 정원 {poi.Capacity} · 좌표 ({poi.X:0.#}, {poi.Z:0.#}){relation}";
    }

    private void AddPatrolPoi(string id)
    {
        ImmutableArray<string> route = SelectedPatrolRoute;
        if (route.Length >= 4 || route.Contains(id, StringComparer.Ordinal)) return;
        _npcPatrolText = string.Join(", ", route.Add(id));
    }

    private void RemovePatrolPoi(int index)
    {
        ImmutableArray<string> route = SelectedPatrolRoute;
        if ((uint)index >= (uint)route.Length) return;
        _npcPatrolText = string.Join(", ", route.RemoveAt(index));
    }

    private void MovePatrolPoi(int index, int offset)
    {
        ImmutableArray<string> route = SelectedPatrolRoute;
        int target = index + offset;
        if ((uint)index >= (uint)route.Length || (uint)target >= (uint)route.Length) return;

        string[] reordered = [.. route];
        (reordered[index], reordered[target]) = (reordered[target], reordered[index]);
        _npcPatrolText = string.Join(", ", reordered);
    }

    private async Task OnArchetypeInput(ChangeEventArgs args)
    {
        _editor = args.Value?.ToString() ?? string.Empty;
        int version = ++_previewVersion;
        await Task.Delay(400);
        if (version != _previewVersion) return;

        try
        {
            _previewCard = Workspace.PreviewArchetype(_selected, _editor);
            _previewError = string.Empty;
        }
        catch (Exception ex)
        {
            _previewError = ex.Message;
        }
    }

    private bool MatchesNpcSearch(StudioNpcSummary npc)
    {
        if (!HasNpcSearch) return true;
        string query = _npcSearch.Trim();
        return npc.Id.ToString().Contains(query, StringComparison.OrdinalIgnoreCase)
            || npc.Archetype.Contains(query, StringComparison.OrdinalIgnoreCase)
            || npc.Zone.Contains(query, StringComparison.OrdinalIgnoreCase)
            || npc.Home.Contains(query, StringComparison.OrdinalIgnoreCase)
            || npc.Workplace.Contains(query, StringComparison.OrdinalIgnoreCase)
            || npc.Faction.Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleNpcGroup(string key)
    {
        if (!_openNpcGroups.Add(key)) _openNpcGroups.Remove(key);
    }

    private string ModeClass(string mode) => _mode == mode ? "active" : string.Empty;
    private string TabClass(string tab) => _tab == tab ? "active" : string.Empty;
    private string SelectedClass(string id) => _selected == id ? "selected" : string.Empty;
    private static string FileDescription(string file) => file switch { "npc_overrides.json" => "개별 NPC 순찰·세력·성격", "archetypes.json" => "직업·성향·허용 행동", "fallback_plans.json" => "LLM 장애 시 기본 행동", "interrupts.json" => "돌발 상황 즉시 반응", "pois.json" => "장소·정원·위치", "zones.json" => "지역과 인접 관계", "items.json" => "아이템과 제작법", "actions.json" => "행동 카탈로그", "factions.json" => "세력 정의", "dialogue_lines.json" => "대사 주제", "context_buckets.json" => "캐시 공간", "world_flags.json" => "세계 상태 비트", _ => string.Empty };
