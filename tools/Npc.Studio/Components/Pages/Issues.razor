@page "/issues"
@inject StudioSession Session

<PageTitle>검증·진단 · NPC Studio</PageTitle>

<Breadcrumb Trail="Crumbs" />

<section class="panel">
    <div class="panel-head">
        <div>
            <small>VALIDATION</small>
            <h1>검증 @(Session.Issues.Length)건</h1>
            <p class="page-lead">
                검증은 <strong>"이 마스터데이터로 서버가 뜨는가"</strong> 를 본다. 하나라도 걸리면 기동이 막힌다.
            </p>
        </div>
        <button class="secondary" @onclick="() => Session.Validate()">다시 검증</button>
    </div>

    <div style="padding:0 16px 16px">
        <IssuePanel Issues="Session.Issues" Limit="200" OkLead="이 마스터데이터로 서버가 뜬다." />
    </div>
</section>

<section class="panel">
    <div class="panel-head">
        <div>
            <small>LINT</small>
            @* 아직 진단을 안 돌렸으면 이 배열은 default 다 — 그대로 Sum 하면 NullReference 다. *@
            <h2>건강 진단 @(_lint.IsDefaultOrEmpty ? 0 : _lint.Sum(l => l.Findings.Length))건</h2>
            <p class="page-lead">
                검증은 통과하지만 이상할 수 있는 것들이다. <strong>차단이 아니라 주의</strong>다 — 의도한 것일 수 있다.
            </p>
        </div>
        <button class="secondary" @onclick="RunLint" disabled="@_busy">@(_busy ? "진단 중…" : "진단 다시 하기")</button>
    </div>

    @if (_lint.IsDefaultOrEmpty)
    {
        <p style="padding:0 18px 18px" class="related">"진단 다시 하기" 를 누르면 직업 @(Session.Catalog.Archetypes.Length)개를 훑는다.</p>
    }
    else if (_lint.All(l => l.Findings.IsEmpty))
    {
        <div class="all-good"><span>✓</span><strong>주의할 것이 없다</strong></div>
    }
    else
    {
        <div class="facts">
            @foreach (StudioLintRow row in _lint.Where(l => !l.Findings.IsEmpty))
            {
                <div class="fact">
                    <h3><a href="@($"/archetypes/{row.Id}")">@row.Name</a> @(row.Findings.Length)건</h3>
                    <LintList Findings="row.Findings" Link="@($"/archetypes/{row.Id}?tab=edit")" />
                </div>
            }
        </div>
    }
</section>

@code {
    [CascadingParameter] public StudioLayout? Layout { get; set; }

    private static readonly (string Label, string Url)[] Crumbs = [("시작", "/"), ("검증·진단", "")];

    private ImmutableArray<StudioLintRow> _lint;
    private bool _busy;

    protected override void OnInitialized()
    {
        Layout?.SetHelp(Help);
        _lint = Session.LintCount is null ? default : Session.Lint();
    }

    /// <summary>
    /// <b>비동기로 돈다.</b> 동기 계산 안에서 <c>_busy</c> 를 켰다 끄면 그 사이에 렌더가 없어
    /// "진단 중…" 이 한 번도 보이지 않는다 — 초보자는 버튼이 죽은 줄 안다.
    /// </summary>
    private async Task RunLint()
    {
        _busy = true;
        StateHasChanged();
        await Task.Yield();

        try { _lint = await Task.Run(() => Session.Lint(force: true)); }
        catch (Exception ex) { Session.Notify(StudioErrors.Humanize(ex, "진단"), true); }
        finally { _busy = false; }
    }

    private RenderFragment Help => @<div>
        <p><strong>검증</strong>과 <strong>진단</strong>은 다른 것이다.</p>
        <ul>
            <li>검증 — 통과하지 못하면 <strong>서버가 뜨지 않는다</strong>.</li>
            <li>진단(L1~L10) — 뜨긴 뜨는데 <strong>이상할 수 있다</strong>. 판단은 사람이 한다.</li>
        </ul>
    </div>;
}
