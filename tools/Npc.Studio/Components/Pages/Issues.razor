@page "/issues"
@inject StudioSession Session
@inject StudioWorkspace Workspace
@inject IssueLocator Locator

<PageTitle>검증·진단 · NPC Studio</PageTitle>

<section class="panel">
    <div class="panel-head">
        <div>
            <small>VALIDATION</small>
            <h1>검증 @(Session.Issues.Length)건</h1>
            <p class="page-lead">
                V1~V15 는 <strong>"이 마스터데이터로 서버가 뜨는가"</strong> 를 본다. 하나라도 걸리면 기동이 막힌다.
            </p>
        </div>
        <button class="secondary" @onclick="() => Session.Validate()">다시 검증</button>
    </div>

    @if (Session.Issues.IsEmpty)
    {
        <div class="all-good"><span>✓</span><strong>전체 검증 통과</strong><p>이 마스터데이터로 서버가 뜬다.</p></div>
    }
    else
    {
        <div class="facts">
            @foreach (StudioIssueView view in Locator.Views(Session.Issues))
            {
                <div class="fact">
                    <h3 class="bad-mark">@view.Title</h3>
                    <p>@view.Issue.Detail</p>
                    @if (!string.IsNullOrEmpty(view.Issue.FixHint))
                    {
                        <p class="fix">고치려면: @view.Issue.FixHint</p>
                    }
                    <div class="inline-row">
                        @if (!string.IsNullOrEmpty(view.Link))
                        {
                            <a class="manual" href="@view.Link">@view.LinkLabel</a>
                        }
                        <span class="related">@view.Issue.Code · @view.Issue.File @view.Issue.Path</span>
                    </div>
                </div>
            }
        </div>
    }
</section>

<section class="panel">
    <div class="panel-head">
        <div>
            <small>LINT</small>
            @* 아직 진단을 안 돌렸으면 이 배열은 default 다 — 그대로 Sum 하면 NullReference 다. *@
            <h2>건강 진단 @(_lint.IsDefaultOrEmpty ? 0 : _lint.Sum(l => l.Findings.Length))건</h2>
            <p class="page-lead">
                검증은 통과하지만 이상할 수 있는 것들이다. <strong>차단이 아니라 주의</strong>다 — 의도한 것일 수 있다.
            </p>
        </div>
        <button class="secondary" @onclick="RunLint" disabled="@_busy">@(_busy ? "진단 중…" : "진단 다시 하기")</button>
    </div>

    @if (_lint.IsDefaultOrEmpty)
    {
        <p style="padding:0 18px 18px" class="related">"진단 다시 하기" 를 누르면 직업 @(Session.Catalog.Archetypes.Length)개를 훑는다.</p>
    }
    else if (_lint.All(l => l.Findings.IsEmpty))
    {
        <div class="all-good"><span>✓</span><strong>주의할 것이 없다</strong></div>
    }
    else
    {
        <div class="facts">
            @foreach ((string Id, string Name, ImmutableArray<LintFinding> Findings) row in _lint.Where(l => !l.Findings.IsEmpty))
            {
                <div class="fact">
                    <h3><a href="@($"/archetypes/{row.Id}")">@row.Name</a> @(row.Findings.Length)건</h3>
                    <LintList Findings="row.Findings" Link="@($"/archetypes/{row.Id}?tab=edit")" />
                </div>
            }
        </div>
    }
</section>

@code {
    [CascadingParameter] public StudioLayout? Layout { get; set; }

    private ImmutableArray<(string Id, string Name, ImmutableArray<LintFinding> Findings)> _lint;
    private bool _busy;

    protected override void OnInitialized() => Layout?.SetHelp(Help);

    private void RunLint()
    {
        _busy = true;

        try
        {
            _lint = Workspace.WithData<ImmutableArray<(string, string, ImmutableArray<LintFinding>)>>((data, instances) =>
            [
                .. data.Archetypes.Archetypes.Select(def =>
                    (def.Id, Lexicon.Archetype(def.Id), ArchetypeLint.Run(data, def, instances))),
            ]);
        }
        catch (Exception ex) { Session.Notify(ex.Message, true); }
        finally { _busy = false; }
    }

    private RenderFragment Help => @<div>
        <p><strong>검증</strong>과 <strong>진단</strong>은 다른 것이다.</p>
        <ul>
            <li>검증(V1~V15) — 통과하지 못하면 <strong>서버가 뜨지 않는다</strong>.</li>
            <li>진단(L1~L10) — 뜨긴 뜨는데 <strong>이상할 수 있다</strong>. 판단은 사람이 한다.</li>
        </ul>
    </div>;
}
