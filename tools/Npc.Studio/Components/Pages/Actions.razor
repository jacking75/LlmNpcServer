@page "/actions"
@inject StudioWorkspace Workspace

<PageTitle>행동 카탈로그 · NPC Studio</PageTitle>

<section class="panel">
    <div class="panel-head">
        <div>
            <small>actions.json</small>
            <h1>행동 @(_actions.Length)개 / 상한 40</h1>
            <p class="page-lead">
                NPC 가 할 수 있는 <strong>원자 동작</strong>이다. LLM 은 이것만 조합해 하루를 짠다.
                추가는 프롬프트를 바꾸는 고급 작업이라 여기서는 읽기만 한다.
            </p>
        </div>
    </div>

    <div class="side-tools">
        <input placeholder="행동 검색 (한국어 · id)" @bind="_search" @bind:event="oninput" />
    </div>

    <div class="facts">
        @foreach (IGrouping<ActionCategory, StudioActionDetail> group in Grouped)
        {
            <div class="fact">
                <h3>@Lexicon.Of(group.Key) @(group.Count())개</h3>
                @foreach (StudioActionDetail action in group)
                {
                    <details>
                        <summary><strong>@Lexicon.Action(action.Id)</strong> <code>@action.Id</code> · @action.Allowed 개 직업이 쓴다</summary>
                        <p>@action.Description</p>
                        <div class="fact-row"><span>전제<FieldInfo File="actions.json" Path="/requires" /></span><span><code>@action.Requires</code></span></div>
                        <div class="fact-row"><span>세움<FieldInfo File="actions.json" Path="/grants" /></span><span><code>@action.Grants</code></span></div>
                        <div class="fact-row"><span>내림<FieldInfo File="actions.json" Path="/clears" /></span><span><code>@action.Clears</code></span></div>
                        <div class="fact-row"><span>소요 시간<FieldInfo File="actions.json" Path="/duration" /></span><span>@action.Duration</span></div>
                        <div class="fact-row"><span>기본 최대 시간<FieldInfo File="actions.json" Path="/default_timeout_s" /></span><span>@(action.DefaultTimeout / 60)분</span></div>
                        <div class="fact-row"><span>인자<FieldInfo File="actions.json" Path="/params" /></span><span>@(action.Params.Length == 0 ? "없음" : string.Join(" · ", action.Params))</span></div>
                    </details>
                }
            </div>
        }
    </div>
</section>

@code {
    /// <summary>행동 한 줄의 읽기 정보 (T21).</summary>
    /// <param name="Id">액션 id.</param>
    /// <param name="Category">분류.</param>
    /// <param name="Description">설명.</param>
    /// <param name="Requires">전제 상태.</param>
    /// <param name="Grants">세우는 상태.</param>
    /// <param name="Clears">내리는 상태.</param>
    /// <param name="Duration">소요 시간 모델 설명.</param>
    /// <param name="DefaultTimeout">기본 최대 시간(초).</param>
    /// <param name="Params">인자 설명.</param>
    /// <param name="Allowed">이 행동을 쓰는 직업 수.</param>
    public sealed record StudioActionDetail(
        string Id,
        ActionCategory Category,
        string Description,
        string Requires,
        string Grants,
        string Clears,
        string Duration,
        int DefaultTimeout,
        ImmutableArray<string> Params,
        int Allowed);

    [CascadingParameter] public StudioLayout? Layout { get; set; }

    private ImmutableArray<StudioActionDetail> _actions;
    private string _search = string.Empty;

    private IEnumerable<IGrouping<ActionCategory, StudioActionDetail>> Grouped =>
        _actions
            .Where(a => string.IsNullOrWhiteSpace(_search)
                || a.Id.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || Lexicon.Action(a.Id).Contains(_search, StringComparison.OrdinalIgnoreCase))
            .GroupBy(a => a.Category)
            .OrderBy(g => (int)g.Key);

    protected override void OnInitialized()
    {
        Layout?.SetHelp(Help);

        _actions = Workspace.WithData<ImmutableArray<StudioActionDetail>>((data, _) =>
        [
            .. data.Actions.Actions.Select(action => new StudioActionDetail(
                action.Id,
                action.Category,
                action.Description,
                WorldFlagTable.Format(action.Requires),
                WorldFlagTable.Format(action.Grants),
                WorldFlagTable.Format(action.Clears),
                DurationOf(action),
                action.DefaultTimeoutSeconds,
                [.. action.Params.Select(p => $"{p.Name}: {p.Type}{(p.Required ? " (필수)" : string.Empty)}")],
                data.Archetypes.Archetypes.Count(a => a.Allows(action.Code)))),
        ]);
    }

    private static string DurationOf(ActionDef action) => action.Duration.Kind switch
    {
        DurationKind.Fixed => $"고정 {action.Duration.BaseSeconds / 60}분",
        DurationKind.Distance => $"거리 비례 — 기본 {action.Duration.BaseSeconds}초 + 1m 당 {action.Duration.PerMeterSeconds}초",
        DurationKind.Param => $"인자에서 ({action.Duration.Param})",
        DurationKind.UntilTime => $"지정한 시간대까지 ({action.Duration.Param})",
        _ => action.Duration.Kind.ToString(),
    };

    private RenderFragment Help => @<div>
        <p>행동은 <strong>37개, 상한 40개</strong>다. 하나를 더하려면 하나를 빼거나 기존 행동의 인자로 흡수한다.</p>
        <p>행동을 고치면 <strong>프롬프트 프리픽스가 바뀌어 미리 구운 플랜이 전량 무효</strong>가 된다 (튜토리얼 9장).</p>
        <p>그래도 고쳐야 한다면 <a href="/files/actions.json">JSON 원문</a>에서 한다.</p>
    </div>;
}
