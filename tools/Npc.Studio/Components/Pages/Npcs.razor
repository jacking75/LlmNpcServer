@page "/npcs"
@page "/npcs/{Id:int}"
@implements IDisposable
@inject StudioSession Session
@inject StudioWorkspace Workspace
@inject StudioForecastService Forecasts

<PageTitle>NPC · NPC Studio</PageTitle>

@if (Id is null)
{
    <Breadcrumb Trail="ListCrumbs" />

    <section class="panel">
        <div class="panel-head">
            <div>
                <small>INSTANCES</small>
                <h1>NPC @Session.Catalog.InstanceCount 명</h1>
                <p class="page-lead">직업으로 생성된 개체다. 명단은 생성물이라 읽기 전용이고, 한 명만 다르게 하려면 개별 설정을 쓴다 — 명단을 다시 만들어도 남는다.</p>
            </div>
        </div>
        <div class="side-tools">
            <input placeholder="번호(#2326) · 직업 · 지역 · 장소" @bind="_search" @bind:event="oninput" aria-label="NPC 검색" />
            <label class="check-line"><input type="checkbox" @bind="_onlyOverrides" /> 개별 설정이 있는 NPC만</label>
        </div>
        @if (Session.Catalog.InstanceCount == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">◇</div>
                <h2>명단이 없다</h2>
                <p><code>npc_instances.json</code> 은 생성물이다 — 아직 만들지 않았다.</p>
                <div style="max-width:560px;margin:0 auto"><ImpactPanel /></div>
            </div>
        }
        else
        {
            <div class="entity-list npc-groups">
                @foreach (IGrouping<string, StudioNpcSummary> archetype in Grouped)
                {
                    string archetypeKey = "a:" + archetype.Key;
                    bool archetypeOpen = HasSearch || _open.Contains(archetypeKey);
                    <button class="npc-group" @onclick="() => Toggle(archetypeKey)" aria-expanded="@archetypeOpen">
                        <span>@(archetypeOpen ? "▾" : "▸")</span>
                        <strong style="color:@Lexicon.ColorOf(Lexicon.Group(archetype.Key))">@Lexicon.Archetype(archetype.Key)</strong>
                        <span class="group-count">@archetype.Count()</span>
                    </button>
                    @if (archetypeOpen)
                    {
                        @foreach (IGrouping<string, StudioNpcSummary> zone in archetype.GroupBy(n => n.Zone).OrderBy(g => g.Key, StringComparer.Ordinal))
                        {
                            string zoneKey = archetypeKey + "/" + zone.Key;
                            bool zoneOpen = HasSearch || _open.Contains(zoneKey);
                            <button class="npc-zone" @onclick="() => Toggle(zoneKey)" aria-expanded="@zoneOpen">
                                <span>@(zoneOpen ? "▾" : "▸")</span><strong>@ZoneName(zone.Key)</strong><span>@zone.Count()명 · 변경 @zone.Count(n => n.HasOverride)</span>
                            </button>
                            @if (zoneOpen)
                            {
                                @foreach (StudioNpcSummary npc in zone.Take(100))
                                {
                                    <a class="npc-row" href="@("/npcs/" + npc.Id)">
                                        <span class="npc-id">#@npc.Id</span>
                                        <span><strong>@npc.Home</strong><small>@npc.Workplace @if (npc.HasOverride) { <em>변경됨</em> }</small></span>
                                    </a>
                                }
                                @if (zone.Count() > 100)
                                {
                                    <p class="list-limit">앞 100명만 표시한다. 검색하면 나머지도 찾을 수 있다.</p>
                                }
                            }
                        }
                    }
                }
            </div>
        }
    </section>
}
else if (_overview is null || _editor is null)
{
    <section class="empty-state">
        <div class="empty-icon">◇</div>
        <h1>NPC @Id 을(를) 찾지 못했다</h1>
        <p>@_error</p>
        <p><a href="/npcs">NPC 목록으로</a></p>
    </section>
}
else
{
    <Breadcrumb Trail="DetailCrumbs" />

    <section class="hero-card">
        <div>
            <small>INSTANCE · NPC @Id</small>
            <h1>@_overview.ArchetypeName #@Id</h1>
            <p>@_overview.Sentence</p>
        </div>
        <div class="stat-grid">
            <div><strong>@_overview.ZoneName</strong><span>지역</span></div>
            <div><strong>@(_overview.Facts.CommuteMeters.ToString("0")) m</strong><span>집 ↔ 일터</span></div>
            <div><strong>@Route.Length</strong><span>순찰 지점</span></div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head"><div><small>MAP</small><h2>어디에 사는가</h2><p class="page-lead">이 지역의 장소다. 좌표는 지역 안에서만 실제다 — 지역끼리 합칠 절대 좌표가 없다.</p></div></div>
        <div style="padding:0 16px 16px">
            @* H23 — 편집 중인 순찰로를 그린다. 예전에는 저장된 값을 그려 클릭해도 선이 안 바뀌었다. *@
            <ZoneMap Pois="_overview.ZonePois" ViewBox="@_viewBox" Route="Route" Dim="Route"
                     Highlight="@_overview.HomeId" PoiClicked="OnPoiClicked" Height="340" />
            <p class="related">
                <span class="chip">집 @_overview.HomeId</span>
                @if (_overview.WorkplaceId.Length > 0) { <span class="chip">일터 @_overview.WorkplaceId</span> }
                @if (!Route.IsEmpty) { <span class="chip">순찰로 @string.Join(" → ", Route)</span> }
            </p>
            <p class="related">지도를 클릭하면 그 장소가 순찰로에 더해진다 (최대 4곳).</p>
        </div>
    </section>

    @if (_forecast is { } preview)
    {
        <section class="panel">
            <div class="panel-head"><div><small>FORECAST</small><h2>이 NPC 의 하루</h2></div></div>
            <BehaviorPreview View="preview" Duty="_duty" />
        </section>
    }
    else
    {
        <section class="panel">
            <div class="panel-head"><div><small>FORECAST</small><h2>이 NPC 의 하루</h2></div></div>
            <p style="padding:0 18px 18px" class="related">하루를 그릴 수 없다 — @(_forecastError.Length > 0 ? _forecastError : "하루 일과를 찾지 못했다 (V7).")</p>
        </section>
    }

    <section class="panel override-panel">
        <div class="panel-head">
            <div>
                <small>npc_overrides.json</small>
                <h2>개별 설정</h2>
                <p>생성된 집·일터·스폰은 유지하고 이 NPC만 다른 행동 파라미터를 정의한다.</p>
            </div>
            <div class="button-row compact">
                <button class="primary" @onclick="SaveOverride" disabled="@(Session.Catalog.ReadOnly || _busy || !Dirty)">검증하고 저장</button>
                <button class="secondary" @onclick="Reset" disabled="@(!Dirty)">초안 취소</button>
                <button class="secondary danger" @onclick="DeleteOverride" disabled="@(Session.Catalog.ReadOnly || _busy || !_editor.Exists)">개별 설정 삭제</button>
            </div>
        </div>
        @if (!Session.LastRejected.IsEmpty && _justRejected)
        {
            <div style="padding:0 16px 8px"><IssuePanel Issues="Session.LastRejected" Limit="8" ShowAllGood="false" /></div>
        }
        <fieldset class="override-grid" disabled="@Session.Catalog.ReadOnly">
            <div class="wide patrol-field" data-field="patrol_route">
                <span class="field-title">순찰 경로 POI<FieldInfo File="npc_overrides.json" Path="/patrol_route" /></span>
                <div class="patrol-picker">
                    <div class="selected-route">
                        <strong>선택한 순서</strong>
                        @if (Route.IsEmpty)
                        {
                            <p>아직 선택한 장소가 없다. 지도를 클릭하거나 아래 목록에서 고른다.</p>
                        }
                        else
                        {
                            @for (int index = 0; index < Route.Length; index++)
                            {
                                int routeIndex = index;
                                string poiId = Route[index];
                                StudioPoiChoice? choice = _editor.ZonePois.FirstOrDefault(p => p.Id == poiId);
                                <div class="route-row">
                                    <span class="route-number">@(index + 1)</span>
                                    <span><strong>@(choice?.Label ?? poiId)</strong><small>@Describe(choice)</small></span>
                                    <span class="route-actions">
                                        <button title="앞으로" aria-label="앞으로" @onclick="() => Move(routeIndex, -1)" disabled="@(index == 0)">↑</button>
                                        <button title="뒤로" aria-label="뒤로" @onclick="() => Move(routeIndex, 1)" disabled="@(index == Route.Length - 1)">↓</button>
                                        <button title="제거" aria-label="제거" @onclick="() => Remove(routeIndex)">×</button>
                                    </span>
                                </div>
                            }
                        }
                    </div>
                    <div class="poi-browser">
                        <div class="poi-search"><strong>같은 지역의 장소</strong><input placeholder="장소 ID · 유형 · 세부 종류 검색" @bind="_poiSearch" @bind:event="oninput" aria-label="장소 검색" /></div>
                        <div class="poi-choice-list">
                            @foreach (StudioPoiChoice poi in PoiChoices)
                            {
                                bool selected = Route.Contains(poi.Id, StringComparer.Ordinal);
                                <button class="poi-choice" @onclick="() => Add(poi.Id)" disabled="@(selected || Route.Length >= MaxRoute)">
                                    <span><strong>@poi.Label</strong><small>@Describe(poi)</small></span><em>@(selected ? "선택됨" : "+ 추가")</em>
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <small class="field-help">같은 지역의 장소를 최대 @MaxRoute 개까지 순서대로 선택한다. 하루 일과의 <code>$patrol_route</code> 는 첫 지점으로 붙는다.</small>
                <details class="direct-poi-input">
                    <summary>POI ID를 직접 입력한다</summary>
                    <textarea rows="3" placeholder="guardhouse_001_04, market_stall_001_04" @bind="_patrolText" aria-label="순찰로 POI ID"></textarea>
                    <small>쉼표나 줄바꿈으로 구분한다. 목록에 없는 ID는 저장 검증에서 거절된다.</small>
                </details>
                <FieldError Issues="Session.LastRejected" Field="patrol_route" Array="overrides" Show="_justRejected" />
            </div>
            <label data-field="aggro_radius_m">
                <span>경계 반경(m)<FieldInfo File="npc_overrides.json" Path="/aggro_radius_m" /></span>
                <input type="number" min="0" max="200" placeholder="직업 기본값" value="@_aggro" @onchange="OnAggro" />
            </label>
            <label data-field="faction">
                <span>세력<FieldInfo File="npc_overrides.json" Path="/faction" /></span>
                <select @bind="_faction">
                    <option value="">미지정</option>
                    @foreach ((string Id, string Description) faction in Factions)
                    {
                        <option value="@faction.Id">@(faction.Description.Length > 0 ? faction.Description : faction.Id) (@faction.Id)</option>
                    }
                </select>
            </label>
            <label data-field="dialogue_profile">
                <span>대화 프로필<FieldInfo File="npc_overrides.json" Path="/dialogue_profile" /></span>
                <input list="dialogue-profiles" placeholder="guard_stern_01" @bind="_dialogue" />
                <datalist id="dialogue-profiles">
                    @foreach (string profile in _editor.DialogueProfiles)
                    {
                        <option value="@profile"></option>
                    }
                </datalist>
                <small class="field-help">
                    @(_editor.DialogueProfiles.IsEmpty
                        ? "아직 쓰인 프로필이 없다 — 대화 서비스가 아는 값을 넣는다."
                        : "이미 쓰인 값에서 고른다. 새 값도 넣을 수 있다.")
                </small>
            </label>
            <label data-field="schedule_offset_min">
                <span>일정 오프셋(분)<FieldInfo File="npc_overrides.json" Path="/schedule_offset_min" /></span>
                <input type="number" min="-120" max="120" placeholder="추가 오프셋 없음" value="@_offset" @onchange="OnOffset" />
            </label>
        </fieldset>
    </section>

    <details class="panel">
        <summary style="padding:14px 18px">전문가 카드</summary>
        <MarkdownView Content="@_card" />
    </details>
}

@code {
    /// <summary>NPC 번호. 없으면 목록이다.</summary>
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] public StudioLayout? Layout { get; set; }

    /// <summary>순찰로 상한. <c>npc_overrides.json</c> 스키마와 같은 값이다.</summary>
    private const int MaxRoute = 4;

    private static readonly (string Label, string Url)[] ListCrumbs = [("시작", "/"), ("NPC", "")];

    private readonly HashSet<string> _open = new(StringComparer.Ordinal);
    private StudioNpcOverview? _overview;
    private StudioNpcOverrideEditor? _editor;
    private StudioForecast? _forecast;
    private ImmutableArray<Npc.Core.TimeOfDay> _duty;
    private string _viewBox = "0 0 100 100";
    private string _card = string.Empty;
    private string _error = string.Empty;
    private string _forecastError = string.Empty;
    private string _search = string.Empty;
    private string _poiSearch = string.Empty;
    private string _patrolText = string.Empty;
    private string _originalPatrol = string.Empty;
    private bool _onlyOverrides;
    private bool _busy;
    private bool _justRejected;
    private int? _aggro;
    private string _faction = string.Empty;
    private string _dialogue = string.Empty;
    private int? _offset;
    private int _loaded = -1;
    private int _generation = -1;

    private (string Label, string Url)[] DetailCrumbs =>
        [("시작", "/"), ("NPC", "/npcs"), ($"#{Id}", "")];

    private bool HasSearch => !string.IsNullOrWhiteSpace(_search);

    private ImmutableArray<string> Route => ParseRoute();

    private ImmutableArray<(string Id, string Description)> Factions =>
        _editor is null || _editor.FactionNotes.IsDefaultOrEmpty
            ? [.. (_editor?.Factions ?? []).Select(f => (f, string.Empty))]
            : _editor.FactionNotes;

    private bool Dirty =>
        _editor is not null
        && (!string.Equals(_patrolText, _originalPatrol, StringComparison.Ordinal)
            || _aggro != _editor.AggroRadiusM
            || !string.Equals(_faction, _editor.Faction, StringComparison.Ordinal)
            || !string.Equals(_dialogue, _editor.DialogueProfile, StringComparison.Ordinal)
            || _offset != _editor.ScheduleOffsetMinutes);

    private IEnumerable<StudioNpcSummary> Filtered =>
        Session.Npcs().Where(n => (!_onlyOverrides || n.HasOverride) && Matches(n)).Take(400);

    private IEnumerable<IGrouping<string, StudioNpcSummary>> Grouped =>
        Filtered.GroupBy(n => n.Archetype).OrderBy(g => g.Key, StringComparer.Ordinal);

    private IEnumerable<StudioPoiChoice> PoiChoices => _editor?.ZonePois.Where(MatchesPoi) ?? [];

    protected override void OnInitialized() =>
        Session.RegisterDirty(this, () => Dirty, $"NPC #{Id} 개별 설정");

    protected override void OnParametersSet()
    {
        Layout?.SetHelp(Help);

        if (Id is null)
        {
            _overview = null;

            if (_open.Count == 0 && Session.Npcs().FirstOrDefault() is { } first)
            {
                _ = _open.Add("a:" + first.Archetype);
                _ = _open.Add("a:" + first.Archetype + "/" + first.Zone);
            }

            return;
        }

        if (_loaded == Id && _generation == Session.Generation) return;

        LoadNpc(Id.Value);
    }

    private void LoadNpc(int id)
    {
        try
        {
            _overview = Workspace.LoadNpcOverview(id);
            _viewBox = StudioForecastService.ViewBoxOf(_overview.ZonePois);
            _card = Workspace.LoadNpcCard(id);
            _duty = DutyOf(_overview.Facts.ArchetypeId);
            LoadFields(Workspace.LoadNpcOverride(id));
            _loaded = id;
            _generation = Session.Generation;
            _error = string.Empty;
            _justRejected = false;
        }
        catch (Exception ex)
        {
            _overview = null;
            _editor = null;
            _error = StudioErrors.Humanize(ex, "NPC 읽기");
            return;
        }

        // 예측은 따로 잡는다 — 하루를 못 그려도 개별 설정은 고칠 수 있어야 한다.
        try
        {
            _forecast = Forecasts.Load(_overview.Facts.ArchetypeId, id);
            _forecastError = string.Empty;
        }
        catch (Exception ex)
        {
            _forecast = null;
            _forecastError = StudioErrors.Humanize(ex);
        }
    }

    private ImmutableArray<Npc.Core.TimeOfDay> DutyOf(string archetypeId)
    {
        try
        {
            return Session.Catalog.Archetypes.Any(a => a.Id == archetypeId)
                ? Workspace.LoadArchetypeView(archetypeId).Facts.DutyHours
                : [];
        }
        catch (Exception)
        {
            return [];
        }
    }

    private void LoadFields(StudioNpcOverrideEditor editor)
    {
        _editor = editor;
        _patrolText = string.Join(", ", editor.PatrolRoute);
        _originalPatrol = _patrolText;
        _poiSearch = string.Empty;
        _aggro = editor.AggroRadiusM;
        _faction = editor.Faction;
        _dialogue = editor.DialogueProfile;
        _offset = editor.ScheduleOffsetMinutes;
    }

    private void Reset()
    {
        if (_editor is { } editor)
        {
            LoadFields(editor);
        }
    }

    private void OnPoiClicked(string id) => Add(id);

    private void OnAggro(ChangeEventArgs args) => _aggro = Clamp(args.Value, 0, 200);

    private void OnOffset(ChangeEventArgs args) => _offset = Clamp(args.Value, -120, 120);

    /// <summary>범위는 서버에서도 지킨다 — 브라우저의 min/max 는 붙여넣기를 막지 않는다.</summary>
    private static int? Clamp(object? value, int min, int max)
    {
        string text = value?.ToString() ?? string.Empty;

        return text.Length == 0 || !int.TryParse(text, out int number) ? null : Math.Clamp(number, min, max);
    }

    private void SaveOverride() => Save(deleting: false);

    private async Task DeleteOverride()
    {
        if (_overview is null || _editor is null)
        {
            return;
        }

        var lines = new List<string>
        {
            $"#{Id} 의 개별 설정: "
            + string.Join(
                " · ",
                Describe(_editor.PatrolRoute.Length > 0 ? $"순찰로 {_editor.PatrolRoute.Length}곳" : string.Empty)
                    .Concat(Describe(_editor.Faction.Length > 0 ? "세력 " + _editor.Faction : string.Empty))
                    .Concat(Describe(_editor.DialogueProfile.Length > 0 ? "대화 프로필" : string.Empty))
                    .Concat(Describe(_editor.AggroRadiusM is not null ? "경계 반경" : string.Empty))
                    .Concat(Describe(_editor.ScheduleOffsetMinutes is not null ? "일정 오프셋" : string.Empty))),
            "지워지고 직업 기본값으로 돌아간다.",
            "백업에서 복원할 수 있다.",
        };

        bool go = Layout is null || await Layout.ConfirmAsync($"NPC #{Id} 의 개별 설정을 지운다", lines, "삭제", danger: true);

        if (!go)
        {
            return;
        }

        _patrolText = string.Empty;
        _aggro = null;
        _faction = string.Empty;
        _dialogue = string.Empty;
        _offset = null;

        Save(deleting: true);
    }

    private static IEnumerable<string> Describe(string value) => value.Length > 0 ? [value] : [];

    private void Save(bool deleting)
    {
        if (_busy || _editor is null) return;

        _busy = true;

        try
        {
            StudioSaveResult result = Workspace.SaveNpcOverride(new StudioNpcOverrideDraft(
                Id!.Value, Route, _aggro, _faction, _dialogue, _offset)
            {
                Stamp = _editor.Stamp,
            });

            Session.Apply(result);
            _justRejected = !result.Saved;

            if (result.Saved)
            {
                _loaded = -1;
                LoadNpc(Id.Value);
            }
            else if (deleting)
            {
                // 삭제가 거절되면 화면만 비워진 채 남지 않게 되돌린다.
                Reset();
            }
        }
        catch (Exception ex)
        {
            Session.Notify(StudioErrors.Humanize(ex, "저장"), true);

            if (deleting)
            {
                Reset();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private ImmutableArray<string> ParseRoute() =>
    [
        .. _patrolText
            .Split([',', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.Ordinal),
    ];

    private void Add(string id)
    {
        ImmutableArray<string> route = Route;

        if (route.Length >= MaxRoute)
        {
            Session.Notify($"순찰로는 최대 {MaxRoute}곳이다 — 하나를 빼고 더한다.", true);
            return;
        }

        if (route.Contains(id, StringComparer.Ordinal))
        {
            Session.Notify("이미 순찰로에 있다.", true);
            return;
        }

        _patrolText = string.Join(", ", route.Add(id));
    }

    private void Remove(int index)
    {
        ImmutableArray<string> route = Route;
        if ((uint)index >= (uint)route.Length) return;
        _patrolText = string.Join(", ", route.RemoveAt(index));
    }

    private void Move(int index, int offset)
    {
        ImmutableArray<string> route = Route;
        int target = index + offset;
        if ((uint)index >= (uint)route.Length || (uint)target >= (uint)route.Length) return;

        string[] reordered = [.. route];
        (reordered[index], reordered[target]) = (reordered[target], reordered[index]);
        _patrolText = string.Join(", ", reordered);
    }

    private string ZoneName(string zoneId) =>
        Workspace.WithData((data, _) => Lexicon.Zone(data, zoneId));

    private bool Matches(StudioNpcSummary npc)
    {
        if (!HasSearch) return true;
        string query = _search.Trim();

        // 번호 검색은 정확 일치가 먼저다 — "23" 으로 2326·1233 이 다 걸리면 못 찾는다.
        if (query.StartsWith('#') && int.TryParse(query[1..], out int exact))
        {
            return npc.Id == exact;
        }

        if (int.TryParse(query, out int number) && npc.Id == number)
        {
            return true;
        }

        return npc.Archetype.Contains(query, StringComparison.OrdinalIgnoreCase)
            || Lexicon.Archetype(npc.Archetype).Contains(query, StringComparison.OrdinalIgnoreCase)
            || npc.Zone.Contains(query, StringComparison.OrdinalIgnoreCase)
            || npc.Home.Contains(query, StringComparison.OrdinalIgnoreCase)
            || npc.Workplace.Contains(query, StringComparison.OrdinalIgnoreCase)
            || npc.Faction.Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesPoi(StudioPoiChoice poi)
    {
        if (string.IsNullOrWhiteSpace(_poiSearch)) return true;
        string query = _poiSearch.Trim();

        return poi.Id.Contains(query, StringComparison.OrdinalIgnoreCase)
            || poi.Type.Contains(query, StringComparison.OrdinalIgnoreCase)
            || poi.Label.Contains(query, StringComparison.OrdinalIgnoreCase)
            || poi.Subtype.Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private static string Describe(StudioPoiChoice? poi)
    {
        if (poi is null) return "현재 지역 목록에서 찾을 수 없는 ID다.";
        string relation = poi.IsHome ? " · 이 NPC의 집" : poi.IsWorkplace ? " · 이 NPC의 일터" : string.Empty;

        return $"{poi.Id} · 정원 {poi.Capacity}{relation}";
    }

    private void Toggle(string key)
    {
        if (!_open.Add(key)) _ = _open.Remove(key);
    }

    /// <summary>회로가 끊기면 초안 등록을 놓는다.</summary>
    public void Dispose() => Session.Unregister(this);

