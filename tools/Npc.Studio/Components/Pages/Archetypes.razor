@page "/archetypes"
@page "/archetypes/{Id}"
@implements IDisposable
@inject StudioSession Session
@inject StudioWorkspace Workspace
@inject StudioForecastService Forecasts
@inject PlanStoreReader Store
@inject NavigationManager Nav

<PageTitle>직업 · NPC Studio</PageTitle>

<Breadcrumb Trail="Crumbs" />

@if (string.IsNullOrEmpty(Id))
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <small>ARCHETYPES</small>
                <h1>직업 @(Session.Catalog.Archetypes.Length)개</h1>
                <p class="page-lead">직업은 NPC 의 종류다. 정의 하나를 수백 명이 함께 쓴다 — 성격·행동·일터·하루 일과가 여기 모여 있다.</p>
            </div>
            <a class="primary manual" href="/archetypes/new">+ 새 직업 만들기</a>
        </div>

        <div class="side-tools">
            <input placeholder="직업 검색 (한국어 · id)" @bind="_search" @bind:event="oninput" />
        </div>

        <div class="facts">
            <div class="fact">
                <h3>인구 분포</h3>
                @if (!Store.Available)
                {
                    <p class="related">미리 구운 계획(<code>planstore/</code>)이 없어 상황별 탭을 숨겼다 — 튜토리얼 17장.</p>
                }
                @foreach (StudioArchetype item in Session.Catalog.Archetypes.OrderByDescending(a => a.Population))
                {
                    <div class="fact-row">
                        <span><a href="@("/archetypes/" + item.Id)">@Lexicon.Archetype(item.Id)</a></span>
                        <span class="trait-track" style="width:200px">
                            <span class="trait-fill" style="width:@(Percent(item.Population))%;background:@Lexicon.ColorOf(Lexicon.Group(item.Id))"></span>
                        </span>
                        <span>@item.Population 명</span>
                    </div>
                }
            </div>
        </div>

        @foreach (IGrouping<Lexicon.ArchetypeGroup, StudioArchetype> group in Grouped)
        {
            <h3 style="padding:0 16px;color:@Lexicon.ColorOf(group.Key)">@Lexicon.Of(group.Key) @(group.Count())</h3>
            <div class="card-grid">
                @foreach (StudioArchetype item in group)
                {
                    <a class="entity-card" href="@("/archetypes/" + item.Id)">
                        <strong>@Lexicon.Archetype(item.Id)</strong>
                        <small>@item.Id · code @item.Code</small>
                        <p>@item.Description</p>
                        <span class="entity-meta">@item.Population 명 · 일터 @item.Workplace</span>
                    </a>
                }
            </div>
        }
    </section>
}
else if (_view is null)
{
    <section class="empty-state">
        <div class="empty-icon">◇</div>
        <h1>@Id 을(를) 찾지 못했다</h1>
        <p>@_error</p>
        <p><a href="/archetypes">직업 목록으로</a></p>
    </section>
}
else
{
    <section class="hero-card">
        <div>
            <small>ARCHETYPE · @Id · code @_view.Facts.Def.Code.Value</small>
            <h1>@_view.Name <span class="chip" style="border-color:@_view.Color">@Lexicon.Of(_view.Group)</span></h1>
            <p>@_view.Facts.Def.Description</p>
        </div>
        <div class="stat-grid">
            <div><strong>@_view.Facts.Population</strong><span>인구</span></div>
            <div><strong>@_view.Facts.AllowedCount</strong><span>할 수 있는 행동</span></div>
            <div><strong>@_view.Facts.Interrupts.Length</strong><span>돌발 반응</span></div>
        </div>
    </section>

    <nav class="content-tabs">
        <button class="@TabClass("overview")" @onclick='() => SetTab("overview")'>개요</button>
        <button class="@TabClass("forecast")" @onclick='() => SetTab("forecast")'>하루 미리보기</button>
        <button class="@TabClass("edit")" @onclick='() => SetTab("edit")'>편집</button>
        <button class="@TabClass("fallback")" @onclick='() => SetTab("fallback")'>하루 일과</button>
        @if (Store.Available)
        {
            @* H20 — 미리 구운 계획이 없으면 탭 자체를 숨긴다. 열어 봐야 빈 화면이다. *@
            <button class="@TabClass("buckets")" @onclick='() => SetTab("buckets")'>상황별</button>
        }
        <button class="@TabClass("card")" @onclick='() => SetTab("card")'>전문가 카드</button>
        <button class="@TabClass("json")" @onclick='() => SetTab("json")'>고급 · JSON</button>
    </nav>

    @switch (Tab)
    {
        case "overview":
            <ArchetypeOverview View="_view" Forecast="_forecast" />
            break;

        case "forecast":
            @if (_forecast is { } preview)
            {
                <section class="panel">
                    <div class="panel-head">
                        <div><small>FORECAST</small><h2>하루 미리보기</h2></div>
                        @if (!preview.Alternatives.IsDefaultOrEmpty)
                        {
                            <label>기준 개체
                                <select @onchange="OnNpcPicked">
                                    @foreach (int npc in preview.Alternatives)
                                    {
                                        <option value="@npc" selected="@(npc == _npcId)">#@npc</option>
                                    }
                                </select>
                            </label>
                        }
                    </div>
                    <BehaviorPreview View="preview" Duty="_view.Facts.DutyHours" />
                </section>
            }
            else
            {
                <section class="empty-state"><div class="empty-icon">◇</div><h1>하루를 그릴 수 없다</h1><p>하루 일과(폴백 플랜)를 찾지 못했다 — V7 을 본다.</p></section>
            }
            break;

        case "edit":
            <ArchetypeForm Id="@Id" FocusField="@QueryField" OnSaved="Reload" />
            break;

        case "fallback":
            <FallbackForm Id="@Id" FocusField="@QueryField" OnSaved="Reload" />
            break;

        case "buckets" when Store.Available:
            <BucketGrid ArchetypeId="@Id" />
            break;

        case "card":
            <section class="panel">
                <div class="panel-head"><div><small>검수용</small><h2>아키타입 카드</h2></div></div>
                <MarkdownView Content="@Card" />
            </section>
            break;

        default:
            <section class="panel editor-panel">
                <div class="panel-head">
                    <div><small>archetypes.json</small><h2>@Id 항목</h2><p class="page-lead">고급이다. 폼으로 되는 일은 편집 탭에서 한다.</p></div>
                    <div class="button-row compact">
                        <button class="primary" @onclick="SaveJson" disabled="@(Session.Catalog.ReadOnly || !JsonDirty)">검증하고 저장</button>
                        <button class="secondary" @onclick="() => _editor = _editorOriginal" disabled="@(!JsonDirty)">초안 취소</button>
                    </div>
                </div>
                <div class="draft-grid">
                    <div><div class="pane-label">JSON 초안</div><textarea class="code-editor" spellcheck="false" value="@_editor" @oninput="OnInput"></textarea></div>
                    <div class="live-preview">
                        <div class="preview-head">
                            <span>실시간 설명</span>
                            @if (string.IsNullOrEmpty(_previewError)) { <span class="live-dot">● 반영됨</span> } else { <span class="preview-bad">JSON 확인 필요</span> }
                        </div>
                        @if (!string.IsNullOrEmpty(_previewError))
                        {
                            <div class="preview-error"><strong>현재 초안을 설명할 수 없다.</strong><span>@_previewError</span></div>
                        }
                        <MarkdownView Content="@_previewCard" Class="preview-card" />
                    </div>
                </div>
            </section>
            break;
    }
}

@code {
    [Parameter] public string? Id { get; set; }
    [CascadingParameter] public StudioLayout? Layout { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? QueryTab { get; set; }
    [SupplyParameterFromQuery(Name = "field")] public string? QueryField { get; set; }

    private StudioArchetypeView? _view;
    private StudioForecast? _forecast;
    private string _editor = string.Empty;
    private string _previewCard = string.Empty;
    private string _previewError = string.Empty;
    private string _error = string.Empty;
    private string _search = string.Empty;
    private string _card = string.Empty;
    private string? _tab;
    private string _shownTab = string.Empty;
    private int? _npcId;
    private int _previewVersion;
    private string _loaded = string.Empty;
    private string _editorOriginal = string.Empty;
    private int _generation = -1;
    private StudioStamp? _stamp;

    /// <summary>원문 탭에도 초안이 있다 (H01). 예전에는 바뀐 것을 추적조차 안 했다.</summary>
    private bool JsonDirty => !string.Equals(_editor, _editorOriginal, StringComparison.Ordinal);

    private string Tab => _tab ?? QueryTab ?? "overview";

    private (string Label, string Url)[] Crumbs =>
        string.IsNullOrEmpty(Id)
            ? [("시작", "/"), ("직업", "")]
            : [("시작", "/"), ("직업", "/archetypes"), (_view?.Name ?? Id, "")];
    private string Card => _card;

    private IEnumerable<StudioArchetype> Filtered =>
        Session.Catalog.Archetypes.Where(a =>
            string.IsNullOrWhiteSpace(_search)
            || a.Id.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || Lexicon.Archetype(a.Id).Contains(_search, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<IGrouping<Lexicon.ArchetypeGroup, StudioArchetype>> Grouped =>
        Filtered.GroupBy(a => Lexicon.Group(a.Id)).OrderBy(g => (int)g.Key);

    private int Percent(int population)
    {
        int max = Math.Max(1, Session.Catalog.Archetypes.Max(a => a.Population));

        return (int)Math.Round(population * 100.0 / max);
    }

    protected override void OnInitialized()
    {
        Session.RegisterDirty(this, () => JsonDirty, $"{Id} 원문 편집");

        // H13 3 — 상단 "새로고침" 은 세대 번호만 올린다. 페이지가 그것을 안 들으면
        // <b>다시 그려지지 않아</b> `OnParametersSet` 이 돌지 않고, 가드가 옳아도
        // 화면은 옛 값 그대로다 — 자식 폼(ArchetypeForm)까지 같이 멈춘다.
        Session.Changed += OnSessionChanged;
    }

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>초안 상태가 바뀌면 레이아웃의 이탈 가드도 같이 바뀌어야 한다 (H01).</summary>
    protected override void OnAfterRender(bool firstRender) => Session.SyncDirty();

    /// <summary>회로가 끊기면 초안 등록을 놓는다.</summary>
    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Session.Unregister(this);
    }

    protected override void OnParametersSet()
    {
        Layout?.SetHelp(Help);

        if (string.IsNullOrEmpty(Id))
        {
            _view = null;
            return;
        }

        // 탭은 주소가 정한다 — `/issues` 의 "고치러 가기" 가 같은 직업을 열어도 탭이 따라와야 한다.
        // 회귀: `_loaded == Id` 로 일찍 빠져나가면 그 링크가 무시됐다.
        if (QueryTab is { Length: > 0 } requested && !string.Equals(_shownTab, requested, StringComparison.Ordinal))
        {
            _tab = null;
            _shownTab = requested;
        }

        if (_loaded == Id && _generation == Session.Generation) return;

        _tab = null;
        _npcId = null;
        Load();
        Session.MarkStep("archetype");
    }

    private void Load()
    {
        try
        {
            _view = Workspace.LoadArchetypeView(Id!);
            _forecast = Forecasts.Load(Id!, _npcId);

            StudioArchetypeDocument document = Workspace.LoadArchetype(Id!);

            _editor = document.Json;
            _editorOriginal = document.Json;
            _stamp = document.Stamp;
            _card = document.Card;
            _previewCard = _card;
            _previewError = string.Empty;
            _error = string.Empty;
            _loaded = Id!;
            _generation = Session.Generation;
        }
        catch (Exception ex)
        {
            _view = null;
            _forecast = null;
            _error = StudioErrors.Humanize(ex, "직업 읽기");
        }
    }

    private void Reload()
    {
        _loaded = string.Empty;
        Load();
    }

    /// <summary>
    /// 탭이 주소를 가진다 (H10). 뒤로가기가 탭을 되돌리고, 링크로 탭을 지정할 수 있다.
    ///
    /// <b>여기서 <c>_tab</c> 을 세우지 않는다.</b> 세우면 이탈 가드가 이동을 막아도 화면은
    /// 이미 바뀌어 있다 — "머무르기" 를 눌렀는데 다른 탭이 떠 있으면 무엇이 일어난 것인지 알 수 없다.
    /// 주소만 바꾸고, 실제 전환은 <c>OnParametersSet</c> 이 <c>QueryTab</c> 을 보고 한다.
    /// </summary>
    private void SetTab(string tab) => Nav.NavigateTo($"/archetypes/{Id}?tab={tab}", replace: true);

    private string TabClass(string tab) => Tab == tab ? "active" : string.Empty;

    private void OnNpcPicked(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out int id))
        {
            _npcId = id;
            _ = Session.Try(() => _forecast = Forecasts.Load(Id!, id), "예측");
        }
    }

    private async Task SaveJson()
    {
        if (Layout is { } layout)
        {
            bool go = await layout.ConfirmAsync(
                $"{Id} 항목을 원문으로 저장한다",
                [
                    $"archetypes.json 의 {Id} 항목.",
                    "검증과 로더를 통과해야 쓴다 — 번호를 바꾸면 거절된다.",
                    $"저장 직전의 원본은 백업에 {StudioWorkspace.BackupDays}일 남는다.",
                ],
                "검증하고 저장");

            if (!go)
            {
                return;
            }
        }

        _ = Session.Try(
            () =>
            {
                StudioSaveResult result = Workspace.SaveArchetype(Id!, _editor, _stamp);
                Session.Apply(result);

                if (result.Saved) Reload();
            },
            "저장");
    }

    private async Task OnInput(ChangeEventArgs args)
    {
        _editor = args.Value?.ToString() ?? string.Empty;
        int version = ++_previewVersion;
        await Task.Delay(400);
        if (version != _previewVersion) return;

        try
        {
            _previewCard = Workspace.PreviewArchetype(Id!, _editor);
            _previewError = string.Empty;
        }
        catch (Exception ex) { _previewError = StudioErrors.Humanize(ex); }
    }

    private RenderFragment Help => @<div>
        <p>직업(아키타입)은 <strong>NPC 의 종류</strong>다. 정의 하나를 수백 명이 함께 쓴다.</p>
        <ul>
            <li><strong>개요</strong> — 어디 살고 무엇을 하고 위험하면 어떻게 하는지.</li>
            <li><strong>하루 미리보기</strong> — 정의만으로 계산한 하루를 지도에서 재생한다. 기대 경로이지 약속이 아니다.</li>
            <li><strong>편집</strong> — 값을 바꾸면 오른쪽에서 하루가 다시 그려진다.</li>
            <li><strong>상황별</strong> — 미리 구운 계획(LLM 이 만든 하루)을 버킷 격자로 본다. <code>--planstore</code> 가 없으면 탭이 숨는다.</li>
        </ul>
        <TutorialChecklist />
    </div>;
}
