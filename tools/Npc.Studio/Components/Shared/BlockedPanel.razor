@* H07 — 막힌 상태에도 탈출구가 셋이다: 되돌리기 · 연습장 조작 · 명령줄. *@
@inject StudioSession Session
@inject StudioWorkspace Workspace

<section class="panel blocked-panel">
    <div class="panel-head">
        <div>
            <small>BLOCKED</small>
            <h1>@Title</h1>
            <p class="page-lead">@Lead</p>
        </div>
    </div>

    <p class="blocked-reason">@Session.Catalog.Blocked</p>
    @if (Session.Catalog.BlockedDetail is { Length: > 0 } detail && detail != Session.Catalog.Blocked)
    {
        <details style="padding:0 16px 12px"><summary>로더가 준 원문</summary><pre class="generator-output">@detail</pre></details>
    }

    <div class="facts">
        @if (Session.Catalog.Kind is StudioBlockKind.JsonSyntax or StudioBlockKind.LoaderReject)
        {
            <div class="fact">
                <h3>① 원문을 고친다</h3>
                <p>이 상태는 <strong>다시 만들기로 풀리지 않는다</strong> — 정의 파일 자체가 읽히지 않는다.</p>
                <div class="inline-row">
                    @foreach (string file in StudioWorkspace.EditableFiles)
                    {
                        <a class="secondary manual" href="@("/files/" + file)">@file</a>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="fact">
                <h3>① 파생물을 다시 만든다</h3>
                <p>정의 파일은 그대로다. 거리표·명단만 다시 만들면 화면이 열린다.</p>
                <ImpactPanel />
                <p class="related">
                    버튼을 쓸 수 없으면 터미널에서 직접 돌린다:
                    <code>dotnet run tools/gen_poi_distances.cs</code>
                </p>
            </div>
        }

        <div class="fact">
            <h3>② 방금 저장을 되돌린다</h3>
            @if (_backups.IsDefaultOrEmpty)
            {
                <p class="related">되돌릴 백업이 없다. 한 번 저장하면 생긴다.</p>
            }
            else
            {
                @foreach (StudioBackup backup in _backups.Take(5))
                {
                    StudioBackup row = backup;
                    <div class="fact-row">
                        <span>@backup.SavedAt.ToString("MM-dd HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)</span>
                        <span>@(backup.Label.Length > 0 ? backup.Label : string.Join(" · ", backup.Files))</span>
                        <button class="secondary" @onclick="() => Restore(row)" disabled="@Session.Catalog.ReadOnly">이 상태로 되돌리기</button>
                    </div>
                }
            }
        </div>

        <div class="fact" id="sandbox">
            <h3>③ 연습장</h3>
            @if (Session.Catalog.IsSandbox)
            {
                <p>지금은 <strong>연습장 @Session.Catalog.Sandbox</strong> 을 보고 있다. 원본은 그대로다.</p>
                <div class="inline-row">
                    <button class="primary" @onclick="Apply" disabled="@Session.Catalog.ReadOnly">원본에 적용</button>
                    <button class="secondary" @onclick="Close">원본으로 돌아가기</button>
                    <button class="secondary danger" @onclick="Discard" disabled="@Session.Catalog.ReadOnly">연습장 버리기</button>
                </div>
                <p class="related">
                    장소를 더해서 막힌 것이면 <strong>원본에 적용</strong>한 뒤 거리표를 다시 만든다 —
                    생성기는 원본 <code>masterdata/</code> 만 읽는다.
                </p>
            }
            else
            {
                <p class="related">원본을 보고 있다. 실험은 연습장에서 하면 원본이 안전하다.</p>
            }
        </div>
    </div>
</section>

@code {
    [CascadingParameter] public StudioLayout? Layout { get; set; }

    private ImmutableArray<StudioBackup> _backups;

    private string Title => Session.Catalog.Kind switch
    {
        StudioBlockKind.MissingArtifact => "파생물이 없다",
        StudioBlockKind.StaleDistances => "거리표가 입력과 어긋난다",
        StudioBlockKind.JsonSyntax => "JSON 을 읽을 수 없다",
        _ => "이 마스터데이터를 읽을 수 없다",
    };

    private string Lead => Session.Catalog.Kind switch
    {
        StudioBlockKind.MissingArtifact =>
            "거리표·명단은 도구가 만드는 파일이다. 갓 클론한 저장소에는 없다 — 한 번 만들면 화면이 열린다.",
        StudioBlockKind.StaleDistances =>
            "장소 수가 바뀌었다. 거리표를 다시 만들면 화면이 열린다 — 정의 파일은 그대로다.",
        StudioBlockKind.JsonSyntax =>
            "정의 파일의 문법이 깨졌다. 다시 만들기로는 풀리지 않는다 — 원문을 고치거나 백업에서 되돌린다.",
        _ =>
            "로더가 참조 무결성으로 거절했다. 가리키는 이름이 없는 것이다 — 원문을 고치거나 되돌린다.",
    };

    protected override void OnInitialized() => Session.Try(() => _backups = Workspace.Backups(), "백업 목록 읽기");

    private void Restore(StudioBackup backup) =>
        Session.Try(
            () =>
            {
                Session.Apply(Workspace.Restore(backup));
                Session.Reload();
                _backups = Workspace.Backups();
            },
            "되돌리기");

    private async Task Apply()
    {
        if (Layout is { } layout)
        {
            ImmutableArray<string> changed = Workspace.SandboxChanges();

            bool go = await layout.ConfirmAsync(
                "연습장을 원본에 적용한다",
                [
                    $"{changed.Length}개 파일이 원본을 덮어쓴다: {string.Join(" · ", changed)}",
                    "원본에서 다시 검증한다 — 통과해야 쓴다.",
                    "원본은 백업에서 복원할 수 있다.",
                ],
                "적용");

            if (!go)
            {
                return;
            }
        }

        _ = Session.Try(
            () =>
            {
                Session.Apply(Workspace.ApplyToOrigin());
                Session.Reload();
            },
            "원본에 적용");
    }

    private void Close() =>
        Session.Try(
            () =>
            {
                Workspace.CloseSandbox();
                Session.Reload();
            },
            "원본으로 돌아가기");

    private async Task Discard()
    {
        if (Layout is { } layout)
        {
            ImmutableArray<string> changed = Workspace.SandboxChanges();

            bool go = await layout.ConfirmAsync(
                $"연습장 {Session.Catalog.Sandbox} 을 버린다",
                [
                    changed.IsEmpty
                        ? "원본과 다른 파일이 없다."
                        : $"원본과 다른 파일 {changed.Length}개: {string.Join(" · ", changed)}",
                    "그 변경이 사라진다.",
                    $"lab/.trash/ 에 {StudioWorkspace.BackupDays}일 남는다.",
                ],
                "버리기",
                danger: true);

            if (!go)
            {
                return;
            }
        }

        _ = Session.Try(
            () =>
            {
                Workspace.DiscardSandbox();
                Session.Reload();
                Session.Notify("연습장을 버렸다.");
            },
            "연습장 버리기");
    }
}
