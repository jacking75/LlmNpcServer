{
  "$schema": "../docs/schema/fallback_plans.schema.json",
  "version": 1,
  "plans": [
    {
      "id": "fb_farmer",
      "archetype": "farmer",
      "goal": "gather_and_sell",
      "steps": [
        {
          "action": "MoveTo",
          "args": {
            "poi": "$nearest_field"
          },
          "timeout_s": 300
        },
        {
          "action": "Farm",
          "args": {
            "crop": "wheat",
            "count": 5
          },
          "timeout_s": 900
        },
        {
          "action": "MoveTo",
          "args": {
            "poi": "$market"
          },
          "timeout_s": 300
        },
        {
          "action": "Trade",
          "args": {
            "item": "wheat",
            "amount": 5
          },
          "timeout_s": 600
        },
        {
          "action": "MoveTo",
          "args": {
            "poi": "$home"
          },
          "timeout_s": 300
        },
        {
          "action": "Sleep",
          "args": {
            "until_time": "Morning"
          },
          "timeout_s": 7200
        }
      ],
      "on_step_fail": "skip",
      "loop": true
    },
    {
      "id": "fb_town_guard",
      "archetype": "town_guard",
      "goal": "walk_the_streets",
      "steps": [
        {
          "action": "MoveTo",
          "args": {
            "poi": "$market"
          },
          "timeout_s": 300
        },
        {
          "action": "Observe",
          "args": {
            "target": "nearest:villager",
            "duration_s": 600
          },
          "timeout_s": 900
        },
        {
          "action": "MoveTo",
          "args": {
            "poi": "$gate"
          },
          "timeout_s": 300
        },
        {
          "action": "Wait",
          "args": {
            "duration_s": 600
          },
          "timeout_s": 600
        },
        {
          "action": "MoveTo",
          "args": {
            "poi": "$home"
          },
          "timeout_s": 300
        },
        {
          "action": "Sleep",
          "args": {
            "until_time": "Morning"
          },
          "timeout_s": 7200
        }
      ],
      "on_step_fail": "skip",
      "loop": true
    },
    {
      "id": "fb_villager",
      "archetype": "villager",
      "goal": "do_the_errands",
      "steps": [
        {
          "action": "MoveTo",
          "args": {
            "poi": "$market"
          },
          "timeout_s": 300
        },
        {
          "action": "Gossip",
          "args": {
            "npc": "nearest:farmer",
            "topic": "rumor"
          },
          "timeout_s": 300
        },
        {
          "action": "Wander",
          "args": {
            "duration_s": 600
          },
          "timeout_s": 900
        },
        {
          "action": "MoveTo",
          "args": {
            "poi": "$home"
          },
          "timeout_s": 300
        },
        {
          "action": "Sleep",
          "args": {
            "until_time": "Morning"
          },
          "timeout_s": 7200
        }
      ],
      "on_step_fail": "skip",
      "loop": true
    }
  ]
}
