<Project Sdk="Microsoft.NET.Sdk">

  <!--
    틱 루프 · 플랜 실행기 · 인지 LOD 스캐너. docs/11 §3~§5.
    CLAUDE.md §3 — Npc.Llm 을 절대 참조하지 않는다.
    참조가 생기는 순간 틱 루프에 LLM 호출이 들어올 길이 열린다.
    Architecture_RuntimeDoesNotReferenceLlm 테스트가 이것을 강제한다.
  -->
  <PropertyGroup>
    <RootNamespace>Npc.Runtime</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Npc.Contracts\Npc.Contracts.csproj" />
    <ProjectReference Include="..\Npc.Core\Npc.Core.csproj" />
    <ProjectReference Include="..\Npc.MasterData\Npc.MasterData.csproj" />
    <ProjectReference Include="..\Npc.Planning\Npc.Planning.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CLAUDE.md §2.1 — 로깅은 소스 생성 로거([LoggerMessage])만 쓴다. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!--
    금지 심볼 (A-05). CLAUDE.md §2.1·§2.3 의 규칙 몇 개를 컴파일 단계에서 거든다.

    <b>테스트가 아니라 컴파일이 막는다.</b> 틱 루프에 LINQ 한 줄을 넣으면 부하 테스트가
    야간에 잡아 주지만, 그때는 이미 커밋이 올라간 뒤다 — 여기서 막으면 손이 멈춘다.
    TreatWarningsAsErrors 라 RS0030 이 곧 빌드 실패다.
  -->
  <ItemGroup>
    <AdditionalFiles Include="BannedSymbols.txt" />

    <!-- 분석기다. 런타임 의존이 아니므로 §3 의 "NuGet 0" 규칙과 충돌하지 않는다. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers"
                      PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

</Project>
