<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- 조립 루트. ASP.NET 호스트 · 메트릭 · 대시보드. CLAUDE.md §3 — 전부 참조한다. -->
  <PropertyGroup>
    <RootNamespace>Npc.Host</RootNamespace>
    <AssemblyName>Npc.Host</AssemblyName>
    <NoWarn>$(NoWarn);MEAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 게이트 러너(T1-62)가 조립된 호스트를 그대로 돌린다. 테스트용 조립을 따로 두면
         "기동되는 것"과 "테스트되는 것"이 갈라진다. -->
    <InternalsVisibleTo Include="Npc.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web SDK 는 wwwroot 를 publish 에만 담는다. 빌드 출력에도 넣어야
         ContentRoot(=실행 파일 폴더)에서 dashboard.html 이 잡힌다. docs/11 §10. -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Npc.Contracts\Npc.Contracts.csproj" />
    <ProjectReference Include="..\Npc.Core\Npc.Core.csproj" />
    <ProjectReference Include="..\Npc.MasterData\Npc.MasterData.csproj" />
    <ProjectReference Include="..\Npc.Planning\Npc.Planning.csproj" />
    <ProjectReference Include="..\Npc.Runtime\Npc.Runtime.csproj" />
    <ProjectReference Include="..\Npc.Llm\Npc.Llm.csproj" />
    <ProjectReference Include="..\Npc.Gateway\Npc.Gateway.csproj" />
    <ProjectReference Include="..\Npc.Sim\Npc.Sim.csproj" />
  </ItemGroup>

</Project>
