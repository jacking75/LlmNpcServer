// 시나리오 C — 단계적 차단. docs/15 §4 · docs/00 §2.
//
// "만들 수 있는가" 가 아니라 "끊겨도 도는가" 를 보는 시나리오다.
// 세 단계 모두에서 NPC 가 멈추지 않고, 크래시가 없고, 틱 시간이 예산 안이어야 한다.
//
//   6,000틱  T2 차단   남은 것: 캐시 + T1   → 아키타입 플랜 요청이 T1 으로 페일오버
//  12,000틱  T1 차단   남은 것: 캐시만      → 재계획 전면 중단, 기존 버킷 플랜으로 계속
//  18,000틱  PlanStore 차단  남은 것: 폴백만 → 아키타입 폴백 40개로 5,000 NPC 동작
//
// 틱 수는 --time-scale 60 (게임 하루 = 14,400틱) 기준이다. 18,000틱은 게임 1.25일이다.
{"at_tick": 6000,  "event": "KillSwitch", "target": "T2"}
{"at_tick": 12000, "event": "KillSwitch", "target": "T1"}
{"at_tick": 18000, "event": "KillSwitch", "target": "PlanStore"}
