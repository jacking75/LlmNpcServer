<Project>

  <!--
    중앙 패키지 버전 관리 (A-09).

    예전에는 같은 패키지가 프로젝트마다 다른 버전이었다 — xunit 2.9.2/2.9.3,
    Microsoft.NET.Test.Sdk 17.11.1/17.14.1. 테스트 러너가 둘을 동시에 로드하면
    "여기서는 되는데 저기서는 안 되는" 종류의 사고가 나고, 그것을 재현하려면
    csproj 20개를 전부 열어야 한다. <b>버전은 여기 한 곳에서만 정한다.</b>

    개별 csproj 는 <PackageReference Include="..." /> 로 이름만 적는다.
    Version 을 같이 적으면 NU1008 로 빌드가 깨진다 — 그것이 이 파일의 강제력이다.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="LLM">
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.8.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.1" />
    <PackageVersion Include="OpenAI" Version="2.12.0" />
  </ItemGroup>

  <ItemGroup Label="검증 · 토큰">
    <PackageVersion Include="JsonSchema.Net" Version="9.3.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
    <!-- Tokenizers 2.0.0 이 끌고 오는 Bcl.Memory 9.0.4 에 GHSA-73j8-2gch-69rq 가 있다. 상향 고정. -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="와이어 · 로깅">
    <PackageVersion Include="MemoryPack" Version="1.21.4" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="테스트">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
