    "body": [
      "{",
      "  \"id\": \"fb_${1:beekeeper}\",",
      "  \"archetype\": \"${1:beekeeper}\",",
      "  \"goal\": \"${2:tend_and_rest}\",",
      "  \"loop\": true,",
      "  \"on_step_fail\": \"skip\",",
      "  \"steps\": [",
