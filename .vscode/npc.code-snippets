  "액션": {
    "scope": "json",
    "prefix": "npc-action",
    "description": "actions.json 항목. 40개 상한이다 — 하나를 빼거나 기존 액션의 파라미터로 흡수한다",
    "body": [
      "{",
      "  \"id\": \"${1:Harvest}\",",
      "  \"code\": ${2:0},",
      "  \"category\": \"${3|movement,labor,social,needs,combat,items,misc|}\",",
      "  \"desc\": \"${4:프롬프트 카탈로그에 실린다. 언제 쓰는 액션인지 적는다.}\",",
      "  \"params\": { \"poi\": { \"type\": \"poi_ref\", \"required\": true } },",
      "  \"requires\": [${5:\"AtWorkplace\"}],",
      "  \"requires_any\": [],",
      "  \"forbids\": [\"IsSleeping\"],",
      "  \"grants\": [${6:\"HasRawMaterial\"}],",
      "  \"clears\": [],",
      "  \"duration\": { \"kind\": \"fixed\", \"base_s\": ${7:300} },",
      "  \"cost\": 1,",
      "  \"default_timeout_s\": ${8:600},",
      "  \"emits\": [],",
      "  \"completes_on\": [\"ActionCompleted\"],",
      "  \"fails_on\": [\"ActionFailed\"]",
      "}",
      "$0"
    ]
  },

