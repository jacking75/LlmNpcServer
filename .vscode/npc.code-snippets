    "body": [
      "{",
      "  \"id\": \"${1:beekeeper}\",",
      "  \"code\": ${2:0},",
      "  \"name_key\": \"npc.${1:beekeeper}\",",
      "  \"desc\": \"${3:프롬프트에 실리는 문장이다. 사람이 쓴다.}\",",
      "  \"allowed_actions\": [\"MoveTo\", \"${4:Work}\", \"Eat\", \"Drink\", \"Sleep\", \"Rest\"],",
      "  \"home_poi_type\": \"home\",",
      "  \"workplace_poi_type\": ${5|\"apiary\",null|},",
      "  \"primary_recipes\": [],",
      "  \"traits\": { \"diligence\": ${6:60}, \"sociability\": ${7:50}, \"courage\": ${8:50}, \"greed\": ${9:50} },",
      "  \"default_goals\": [\"${10:tend_hives}\"],",
      "  \"initial_inventory\": [{ \"item\": \"bread\", \"count\": 2 }, { \"item\": \"water\", \"count\": 1 }],",
      "  \"duty_hours\": [],",
