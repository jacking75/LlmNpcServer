{
  "// 이 파일은 무엇인가": [
    "F-08 에디터 지원. VS Code 가 마스터데이터를 편집할 때 자동완성과 인라인 경고를 주게 한다.",
    "스키마는 생성물이다 — `npc schema` 가 docs/schema/ 를 다시 만든다 (E-02).",
    "마스터데이터 파일에는 $schema 가 이미 붙어 있어 대부분 이것 없이도 동작하지만,",
    "아래 매핑은 $schema 를 지운 파일이나 새로 만드는 파일에도 걸린다."
  ],

  "json.schemas": [
    { "fileMatch": ["/masterdata/world_flags.json"], "url": "./docs/schema/world_flags.schema.json" },
    { "fileMatch": ["/masterdata/items.json"], "url": "./docs/schema/items.schema.json" },
    { "fileMatch": ["/masterdata/actions.json"], "url": "./docs/schema/actions.schema.json" },
    { "fileMatch": ["/masterdata/zones.json"], "url": "./docs/schema/zones.schema.json" },
    { "fileMatch": ["/masterdata/pois.json"], "url": "./docs/schema/pois.schema.json" },
    { "fileMatch": ["/masterdata/archetypes.json"], "url": "./docs/schema/archetypes.schema.json" },
    { "fileMatch": ["/masterdata/context_buckets.json"], "url": "./docs/schema/context_buckets.schema.json" },
    { "fileMatch": ["/masterdata/interrupts.json"], "url": "./docs/schema/interrupts.schema.json" },
    { "fileMatch": ["/masterdata/fallback_plans.json"], "url": "./docs/schema/fallback_plans.schema.json" },
    { "fileMatch": ["/masterdata/dialogue_lines.json"], "url": "./docs/schema/dialogue_lines.schema.json" },
    { "fileMatch": ["/masterdata/factions.json"], "url": "./docs/schema/factions.schema.json" },
    { "fileMatch": ["/masterdata/npc_instances.json"], "url": "./docs/schema/npc_instances.schema.json" },
    { "fileMatch": ["/masterdata/npc_overrides.json"], "url": "./docs/schema/npc_overrides.schema.json" }
  ],

  "// 생성물은 열지 않는다": [
    "npc_instances.json 은 3.3MB 고 poi_distances.bin 은 바이너리다.",
    "검색 결과에 섞이면 진짜 소스를 못 찾는다. 편집 대상이 아니라 재생성 대상이다."
  ],
  "search.exclude": {
    "**/masterdata/npc_instances.json": true,
    "**/masterdata/poi_distances.bin": true,
    "**/planstore/plans": true,
    "**/artifacts": true,
    "**/state": true
  },

  "files.associations": {
    "*.jsonl": "jsonl"
  },

  "// 줄 끝": [
    "저장소는 LF 로 커밋한다. 편집기가 CRLF 를 섞으면 diff 가 파일 전체로 번진다."
  ],
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "[csharp]": {
    "editor.formatOnSave": true
  },
  "dotnet.defaultSolution": "NpcServer.sln"
}
